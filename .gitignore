# Machine-local overrides — never tracked.
*.local

# The documented override files are named `local.*`, not `*.local`, so the
# pattern above does not catch them. They belong in ~/.config, not in here —
# this is a safety net against one landing in the repo with secrets in it.
local.zsh
local.ghostty

# Third-party Yazi plugin code, fetched by `ya pkg` into the repo because the
# repo directory is Yazi's config directory. setup.sh restores it from the
# tracked yazi/package.toml lockfile; only the lock is ours.
yazi/plugins/
yazi/flavors/

# Per-project coding-agent permission state.
.claude/settings.local.json

# Implementation specs written while planning a change. Deliberately untracked:
# a spec describes a plan at one moment, not the system, and it rots the day the
# code moves on. What outlives the change is the decision and its reasoning, and
# that gets distilled into docs/decisions/ instead. See .ignore — these files
# stay searchable by coding agents even though git never sees them.
spec/

# install.sh renders atomic writes next to the *destination*, not in here, so
# this is a backstop for scratch files that escape into the repo — not the
# primary guard.
.dotfiles-tmp.*

.DS_Store
