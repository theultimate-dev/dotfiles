#!/usr/bin/env python3
"""agent-sync: bring agent plugins and skills up to date in every harness.

Reads a per-machine manifest (default ${XDG_CONFIG_HOME:-~/.config}/agent-sync/manifest.toml),
asks Claude Code and Codex, through their own plugin CLIs, to hold the plugins it names, copies the
selected skills into agy's personal skills folder, and prints one report. It writes no harness
settings file and never uninstalls anything. See docs/agent-sync.md.

Standard library only. The version gate below must stay the first thing that runs, and this file
must stay parseable by older Pythons so the gate can report.
"""

import sys


def version_gate(info=None):
    """Exit 4, naming the fix, on a Python without tomllib."""
    info = tuple(sys.version_info[:2] if info is None else info[:2])
    if info < (3, 11):
        sys.stderr.write(
            "agent-sync: needs Python 3.11 or newer (it reads TOML with tomllib); "
            "this is Python %d.%d.\n"
            "Install one (for example `brew install python@3.13`) and run agent-sync with it.\n"
            % info)
        sys.exit(4)


version_gate()

import argparse  # noqa: E402
import contextlib  # noqa: E402
import datetime  # noqa: E402
import difflib  # noqa: E402
import errno  # noqa: E402
import fcntl  # noqa: E402
import hashlib  # noqa: E402
import json  # noqa: E402
import os  # noqa: E402
import re  # noqa: E402
import shutil  # noqa: E402
import signal  # noqa: E402
import subprocess  # noqa: E402
import tempfile  # noqa: E402
import threading  # noqa: E402
import tomllib  # noqa: E402
from dataclasses import dataclass, field  # noqa: E402

VERSION = "0.1.0"
HARNESSES = ("claude", "codex", "agy")
SOURCES = ("git", "checkout", "none")

EXIT_OK, EXIT_FAILED, EXIT_USAGE, EXIT_HELD, EXIT_PREREQ, EXIT_INTERRUPTED = 0, 1, 2, 3, 4, 130


class UsageError(Exception):
    """A usage or manifest error: exit 2, nothing runs."""


class PrereqError(Exception):
    """A missing prerequisite: exit 4, nothing runs."""


# ── Manifest ──────────────────────────────────────────────────────────────────────────────────

TOP_KEYS = {"version", "harnesses", "marketplace", "plugin", "skill", "external"}
MARKETPLACE_KEYS = {"name", "git", "ref", "checkout", "claude", "codex", "agy", "harnesses",
                    "plugins", "exclude"}
PLUGIN_KEYS = {"id", "harnesses", "agy_skills"}
SKILL_KEYS = {"name", "git", "ref", "subdir", "path"}
EXTERNAL_KEYS = {"skills"}

GIT_SOURCE = re.compile(r"^([\w.-]+/[\w.-]+|(https?|ssh|git|file)://\S+|[\w.-]+@[\w.-]+:\S+)$")
NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


@dataclass
class Marketplace:
    name: str
    git: str = None
    ref: str = None
    checkout: str = None
    source: dict = field(default_factory=dict)   # harness -> "git" | "checkout" | "none"
    harnesses: tuple = None                        # the default for its plugins
    plugins: str = "listed"
    exclude: tuple = ()


@dataclass
class PluginRow:
    id: str
    name: str
    marketplace: str
    harnesses: tuple            # effective: its own, else the marketplace's
    agy_skills: tuple = None


@dataclass
class LooseSkill:
    name: str
    git: str = None
    ref: str = None
    subdir: str = None
    path: str = None


@dataclass
class Manifest:
    path: str
    harnesses: tuple
    marketplaces: dict          # name -> Marketplace, in file order
    plugins: dict               # id -> PluginRow, in file order
    skills: list
    external: frozenset

    def harnesses_using(self, mkt):
        """The harnesses a marketplace's plugins go to: its default plus every row's."""
        used = set(mkt.harnesses or ())
        for row in self.plugins.values():
            if row.marketplace == mkt.name:
                used.update(row.harnesses)
        return [h for h in HARNESSES if h in used]


def expand_path(value, where, errors):
    path = os.path.expanduser(value)
    if not os.path.isabs(path):
        errors.append("%s: %r is a relative path; use an absolute path or ~/…" % (where, value))
        return None
    return os.path.normpath(path)


def _strings(value, where, errors, allowed=None):
    if not isinstance(value, list) or not all(isinstance(v, str) for v in value):
        errors.append("%s must be a list of strings" % where)
        return ()
    if len(set(value)) != len(value):
        errors.append("%s lists a name twice" % where)
    if allowed is not None:
        for v in value:
            if v not in allowed:
                errors.append("%s: unknown harness %r (expected one of %s)"
                              % (where, v, ", ".join(allowed)))
        return tuple(v for v in value if v in allowed)
    return tuple(value)


def _string(table, key, where, errors, required=False):
    value = table.get(key)
    if value is None:
        if required:
            errors.append("%s: %s is required" % (where, key))
        return None
    if not isinstance(value, str) or not value:
        errors.append("%s: %s must be a non-empty string" % (where, key))
        return None
    return value


def _unknown(table, allowed, where, errors):
    for key in table:
        if key not in allowed:
            errors.append("%s: unknown key %r" % (where, key))


def _tables(doc, key, errors):
    value = doc.get(key, [])
    if not isinstance(value, list) or not all(isinstance(t, dict) for t in value):
        errors.append("%s must be written as [[%s]] tables" % (key, key))
        return []
    return value


def parse_manifest(text, path):
    """Parse and validate a manifest. Raises UsageError listing every problem found."""
    try:
        doc = tomllib.loads(text)
    except tomllib.TOMLDecodeError as e:
        raise UsageError("%s: not valid TOML: %s" % (path, e))
    errors = []
    _unknown(doc, TOP_KEYS, "manifest", errors)
    if doc.get("version") != 1:
        errors.append("manifest: version must be 1 (found %r)" % (doc.get("version"),))
    harnesses = HARNESSES
    if "harnesses" in doc:
        harnesses = _strings(doc["harnesses"], "harnesses", errors, HARNESSES)

    marketplaces = {}
    for i, t in enumerate(_tables(doc, "marketplace", errors), 1):
        where = "marketplace %s" % (t.get("name") if isinstance(t.get("name"), str) else "#%d" % i)
        _unknown(t, MARKETPLACE_KEYS, where, errors)
        name = _string(t, "name", where, errors, required=True)
        if name and not NAME.match(name):
            errors.append("%s: name %r has characters a harness will not take" % (where, name))
        if name in marketplaces:
            errors.append("%s: declared twice" % where)
        m = Marketplace(name=name or "#%d" % i)
        m.git = _string(t, "git", where, errors)
        if m.git and not GIT_SOURCE.match(m.git):
            errors.append("%s: git %r is not owner/repo or an https/ssh Git URL" % (where, m.git))
        m.ref = _string(t, "ref", where, errors)
        for key in ("git", "ref"):
            if (getattr(m, key) or "").startswith("-"):
                errors.append("%s: %s may not begin with -" % (where, key))
        if m.ref and not m.git:
            errors.append("%s: ref needs git" % where)
        checkout = _string(t, "checkout", where, errors)
        if checkout:
            m.checkout = expand_path(checkout, where + " checkout", errors)
        for h in HARNESSES:
            src = t.get(h, "git")
            if src not in SOURCES:
                errors.append("%s: %s must be one of %s (found %r)"
                              % (where, h, ", ".join(SOURCES), src))
                src = "none"
            m.source[h] = src
        if "harnesses" in t:
            m.harnesses = _strings(t["harnesses"], where + " harnesses", errors, HARNESSES)
        m.plugins = t.get("plugins", "listed")
        if m.plugins not in ("listed", "all"):
            errors.append('%s: plugins must be "listed" or "all" (found %r)' % (where, m.plugins))
        if m.plugins == "all" and m.harnesses is None:
            errors.append('%s: plugins = "all" requires harnesses' % where)
        if "exclude" in t:
            m.exclude = _strings(t["exclude"], where + " exclude", errors)
            if m.plugins != "all":
                errors.append('%s: exclude requires plugins = "all"' % where)
        marketplaces[m.name] = m

    plugins = {}
    for i, t in enumerate(_tables(doc, "plugin", errors), 1):
        pid = t.get("id") if isinstance(t.get("id"), str) else None
        where = "plugin %s" % (pid or "#%d" % i)
        _unknown(t, PLUGIN_KEYS, where, errors)
        pid = _string(t, "id", where, errors, required=True)
        if not pid:
            continue
        name, _, mname = pid.partition("@")
        if not name or not mname or "@" in mname:
            errors.append("%s: id must be plugin@marketplace" % where)
            continue
        if not NAME.match(name):
            errors.append("%s: plugin name %r has characters a harness will not take"
                          % (where, name))
        if pid in plugins:
            errors.append("%s: listed twice" % where)
        m = marketplaces.get(mname)
        if m is None:
            errors.append("%s: marketplace %r is not declared" % (where, mname))
            continue
        if name in m.exclude:
            errors.append("%s: is both excluded by marketplace %s and listed" % (where, mname))
        if "harnesses" in t:
            hs = _strings(t["harnesses"], where + " harnesses", errors, HARNESSES)
        elif m.harnesses is not None:
            hs = m.harnesses
        else:
            errors.append("%s: no harnesses, and marketplace %s gives no default"
                          % (where, mname))
            hs = ()
        agy_skills = None
        if "agy_skills" in t:
            agy_skills = _strings(t["agy_skills"], where + " agy_skills", errors)
            if "agy" not in hs:
                errors.append("%s: agy_skills given, but its harnesses omit agy" % where)
        plugins[pid] = PluginRow(id=pid, name=name, marketplace=mname, harnesses=tuple(hs),
                                 agy_skills=agy_skills)

    skills = []
    seen = set()
    for i, t in enumerate(_tables(doc, "skill", errors), 1):
        sname = t.get("name") if isinstance(t.get("name"), str) else None
        where = "skill %s" % (sname or "#%d" % i)
        _unknown(t, SKILL_KEYS, where, errors)
        s = LooseSkill(name=_string(t, "name", where, errors, required=True) or "#%d" % i)
        if s.name in seen:
            errors.append("%s: two [[skill]] entries share this name" % where)
        seen.add(s.name)
        if not NAME.match(s.name):
            errors.append("%s: name is not a valid folder name" % where)
        s.git = _string(t, "git", where, errors)
        s.ref = _string(t, "ref", where, errors)
        s.subdir = _string(t, "subdir", where, errors)
        spath = _string(t, "path", where, errors)
        if (s.git is None) == (spath is None):
            errors.append("%s: give exactly one of git or path" % where)
        if (s.git or "").startswith("-") or (s.ref or "").startswith("-"):
            errors.append("%s: git and ref may not begin with -" % where)
        if s.git and not GIT_SOURCE.match(s.git):
            errors.append("%s: git %r is not owner/repo or an https/ssh Git URL" % (where, s.git))
        if spath:
            s.path = expand_path(spath, where + " path", errors)
        if spath and (s.ref or s.subdir):
            errors.append("%s: ref and subdir go with git, not path" % where)
        if s.subdir and (os.path.isabs(s.subdir) or ".." in s.subdir.split("/")):
            errors.append("%s: subdir must be a path inside the repository" % where)
        skills.append(s)

    external = doc.get("external", {})
    if not isinstance(external, dict):
        errors.append("external must be a table")
        external = {}
    _unknown(external, EXTERNAL_KEYS, "external", errors)
    ext = _strings(external.get("skills", []), "external skills", errors)

    manifest = Manifest(path=path, harnesses=tuple(harnesses), marketplaces=marketplaces,
                        plugins=plugins, skills=skills, external=frozenset(ext))
    for m in marketplaces.values():
        for h in m.harnesses or ():
            if m.source[h] == "none":
                errors.append("marketplace %s: harnesses names %s, whose source is none"
                              % (m.name, h))
        for h in manifest.harnesses_using(m):
            src = m.source[h]
            if src == "git" and not m.git:
                errors.append('marketplace %s: %s uses "git" (the default) but no git is given'
                              % (m.name, h))
            if src == "checkout" and not m.checkout:
                errors.append('marketplace %s: %s = "checkout" requires checkout' % (m.name, h))
    for row in plugins.values():
        m = marketplaces[row.marketplace]
        for h in row.harnesses:
            if m.source[h] == "none" and not (m.harnesses and h in m.harnesses):
                errors.append("plugin %s: goes to %s, but marketplace %s has %s = \"none\""
                              % (row.id, h, m.name, h))
    if errors:
        raise UsageError("\n".join("%s: %s" % (tilde(path), e) for e in errors))
    return manifest


def check_manifest_paths(manifest, run_harnesses):
    """A checkout or path that does not exist is an error only where this run uses it."""
    errors = []
    for m in manifest.marketplaces.values():
        for h in manifest.harnesses_using(m):
            if h in run_harnesses and m.source[h] == "checkout" and not os.path.isdir(m.checkout):
                errors.append("marketplace %s: checkout %s does not exist (used by %s)"
                              % (m.name, tilde(m.checkout), h))
                break
    if "agy" in run_harnesses:
        for s in manifest.skills:
            if s.path and not os.path.isdir(s.path):
                errors.append("skill %s: path %s does not exist" % (s.name, tilde(s.path)))
    if errors:
        raise UsageError("\n".join("%s: %s" % (tilde(manifest.path), e) for e in errors))


def load_manifest(path):
    try:
        with open(path, "rb") as f:
            text = f.read().decode("utf-8")
    except FileNotFoundError:
        raise UsageError("no manifest at %s; copy agent-sync/manifest.example.toml there and "
                         "edit it, or pass --manifest <path>" % tilde(path))
    except (OSError, UnicodeDecodeError) as e:
        raise UsageError("cannot read manifest %s: %s" % (path, e))
    return parse_manifest(text, path)


# ── Paths ─────────────────────────────────────────────────────────────────────────────────────

def home():
    return os.path.expanduser("~")


def tilde(path):
    """A path as the report shows it: the home directory as ~."""
    h = home().rstrip("/")
    if path == h:
        return "~"
    if path.startswith(h + "/"):
        return "~" + path[len(h):]
    return path


def xdg(var, default):
    value = os.environ.get(var)
    return value if value and os.path.isabs(value) else os.path.join(home(), default)


def default_manifest_path():
    return os.path.join(xdg("XDG_CONFIG_HOME", ".config"), "agent-sync", "manifest.toml")


class Paths:
    """Every location agent-sync reads or writes, resolved once from the environment."""

    def __init__(self):
        self.home = home()
        self.state_dir = os.path.join(xdg("XDG_STATE_HOME", ".local/state"), "agent-sync")
        self.state = os.path.join(self.state_dir, "state.json")
        self.lock = os.path.join(self.state_dir, "lock")
        self.log = os.path.join(self.state_dir, "last-run.log")
        self.archive = os.path.join(self.state_dir, "archive")
        self.sources = os.path.join(xdg("XDG_CACHE_HOME", ".cache"), "agent-sync", "sources")
        self.claude_home = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(self.home,
                                                                               ".claude")
        self.codex_home = os.environ.get("CODEX_HOME") or os.path.join(self.home, ".codex")
        self.claude_flat = os.path.join(self.claude_home, "skills")
        self.codex_flat = os.path.join(self.home, ".agents", "skills")
        self.gemini_config = os.path.join(self.home, ".gemini", "config")
        self.agy_skills = os.path.join(self.gemini_config, "skills")
        self.agy_stage = os.path.join(self.gemini_config, ".agent-sync-stage")
        self.agy_builtin = os.path.join(self.home, ".gemini", "antigravity-cli", "builtin",
                                        "skills")


def timestamp():
    return datetime.datetime.now().strftime("%Y-%m-%dT%H-%M-%S")


# ── Run: argv execution ───────────────────────────────────────────────────────────────────────

HARNESS_TIMEOUT = 300
GIT_TIMEOUT = 120
# Contract test C1: without this variable each Claude list call queues a telemetry file under the
# Claude home and opens an outbound connection. Set on the two list calls only (spec §4).
CLAUDE_LIST_ENV = {"CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"}

# Variables that would make git act on another repository than the one named (spec §10).
GIT_ENV = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY", "GIT_COMMON_DIR",
           "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_NAMESPACE", "GIT_CEILING_DIRECTORIES",
           "GIT_DISCOVERY_ACROSS_FILESYSTEM")

_CREDENTIALS = re.compile(r"([A-Za-z][A-Za-z0-9+.-]*://)[^/\s@]+@")


def redact(text):
    """URL credentials (`https://user:token@…`) become `https://***@…`."""
    return _CREDENTIALS.sub(r"\1***@", text)


@dataclass
class Result:
    argv: list
    returncode: int = None
    stdout: str = ""
    stderr: str = ""
    timed_out: bool = False
    missing: bool = False
    timeout: float = 0

    @property
    def ok(self):
        return self.returncode == 0

    def error(self):
        if self.missing:
            return "%s: command not found" % self.argv[0]
        if self.timed_out:
            return "%s timed out after %g s" % (" ".join(self.argv[:3]), self.timeout)
        text = (self.stderr.strip() or self.stdout.strip()).splitlines()
        last = json_last_line(self.stdout)
        if last and last.get("message"):
            return redact(str(last["message"]).splitlines()[-1])
        return redact(text[-1] if text else "exit %s" % self.returncode)


def json_last_line(text):
    """The last stdout line as JSON (Claude prints human lines first even with --json; C4)."""
    for line in reversed(text.strip().splitlines()):
        line = line.strip()
        if line:
            try:
                value = json.loads(line)
            except ValueError:
                return None
            return value if isinstance(value, dict) else None
    return None


def json_document(text):
    try:
        return json.loads(text)
    except ValueError:
        return None


class Runner:
    """Runs argv lists, never through a shell, stdin closed, the caller's environment passed
    through (plus extra_env for that call only). Keeps a redacted log of every call."""

    def __init__(self):
        self.entries = []

    def run(self, argv, timeout=HARNESS_TIMEOUT, extra_env=None, cwd=None):
        env = None
        if extra_env or argv[0] == "git":
            env = {k: v for k, v in os.environ.items() if argv[0] != "git" or k not in GIT_ENV}
            env.update(extra_env or {})
        started = datetime.datetime.now()
        r = Result(argv=list(argv), timeout=timeout)
        try:
            proc = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                                  timeout=timeout, env=env, cwd=cwd, errors="replace")
            r.returncode, r.stdout, r.stderr = proc.returncode, proc.stdout, proc.stderr
        except FileNotFoundError:
            r.missing, r.returncode = True, 127
        except subprocess.TimeoutExpired as e:
            r.timed_out = True
            r.stdout = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else ""
        prefix = " ".join("%s=%s" % kv for kv in sorted((extra_env or {}).items()))
        self.entries.append("%s %s exit=%s %s%s" % (
            started.strftime("%Y-%m-%dT%H:%M:%S"),
            "%.1fs" % (datetime.datetime.now() - started).total_seconds(),
            "timeout" if r.timed_out else r.returncode,
            prefix + " " if prefix else "",
            redact(json.dumps(r.argv))))
        return r

    def write_log(self, path):
        atomic_write(path, "\n".join(self.entries) + ("\n" if self.entries else ""))


def ensure_dir(path, create=True):
    """Make path a real directory, refusing a symlink at it or at any parent below its base
    ($HOME, or the XDG directory it lies in outside $HOME): a link is a refusal, never a
    redirect (spec §10). With create=False it only checks what exists. Raises TreeError."""
    bases = [home()] + [xdg(v, d) for v, d in (("XDG_STATE_HOME", ".local/state"),
                                               ("XDG_CACHE_HOME", ".cache"),
                                               ("XDG_CONFIG_HOME", ".config"))]
    base = next((b for b in bases if path == b or path.startswith(b.rstrip("/") + "/")), None)
    if base is None:
        raise TreeError("%s is outside $HOME and the XDG directories" % path)
    current = base
    for part in [p for p in os.path.relpath(path, base).split(os.sep) if p != "."]:
        current = os.path.join(current, part)
        if os.path.islink(current):
            raise TreeError("%s is a symlink; agent-sync writes nothing through it"
                            % tilde(current))
        if not os.path.isdir(current):
            if not create:
                break
            try:
                os.mkdir(current)
            except OSError as e:
                raise TreeError("cannot create %s: %s" % (tilde(current), e))
    return path


def atomic_write(path, text):
    """Write an exclusively created temp file in the same directory, then rename it into place."""
    ensure_dir(os.path.dirname(path))
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=os.path.basename(path) + ".")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


# ── State and the lock ────────────────────────────────────────────────────────────────────────

class State:
    """state.json: which agy folders agent-sync owns, what it last applied, cleanup runs.

    Saved atomically after each success, and only when its content changed, so a run with
    nothing to do writes nothing (spec §10)."""

    def __init__(self, path):
        self.path = path
        self.data = {"version": 1, "agy": {}, "applied": {}, "cleanup": {}}
        try:
            with open(path) as f:
                loaded = json.load(f)
        except FileNotFoundError:
            loaded = None
        except (OSError, ValueError) as e:
            raise UsageError("cannot read the state file %s: %s; move it aside to start over"
                             % (tilde(path), e))
        if loaded is not None:
            problem = state_problem(loaded)
            if problem:
                raise UsageError("state file %s: %s; move it aside to start over"
                                 % (tilde(path), problem))
            self.data.update(loaded)
        self._saved = self._text()

    def _text(self):
        return json.dumps(self.data, indent=2, sort_keys=True) + "\n"

    def save(self):
        text = self._text()
        if text == self._saved:
            return False
        atomic_write(self.path, text)
        self._saved = text
        return True


STAMP = re.compile(r"^\d{4}-\d\d-\d\dT\d\d-\d\d-\d\d$")


def state_problem(d):
    """Why a loaded state file cannot be trusted, or None. Every name must be one path
    component, because paths are rebuilt from names, never read from the file (spec §10)."""
    if not isinstance(d, dict) or d.get("version") != 1:
        return "not version 1"
    if set(d) - {"version", "agy", "applied", "cleanup"}:
        return "unknown keys %s" % ", ".join(sorted(set(d) - {"version", "agy", "applied",
                                                               "cleanup"}))
    agy, applied, cleanup = d.get("agy", {}), d.get("applied", {}), d.get("cleanup", {})
    def strings(r, keys):
        return all(isinstance(r.get(k), str) for k in keys if k in r)

    if not isinstance(agy, dict) or not all(
            isinstance(k, str) and NAME.match(k) and isinstance(v, dict) and
            isinstance(v.get("digest"), str) and strings(v, ("source", "path", "revision", "time"))
            for k, v in agy.items()):
        return "agy holds a name that is not a folder name, or a record of the wrong shape"
    if not isinstance(applied, dict) or not all(
            h in HARNESSES and isinstance(v, dict) and all(
                isinstance(r, dict) and isinstance(r.get("revision", ""), (str, type(None))) and
                isinstance(r.get("plugins", {}), dict) and
                all(isinstance(x, str) for x in r.get("plugins", {}).values())
                for r in v.values())
            for h, v in applied.items()):
        return "applied is not {harness: {marketplace: record}}"
    if not isinstance(cleanup, dict) or not all(
            STAMP.match(ts) and isinstance(recs, list) and all(
                isinstance(r, dict) and r.get("harness") in ("claude", "codex") and
                isinstance(r.get("name"), str) and isinstance(r.get("slot"), str) and
                NAME.match(r["name"]) and
                re.match(r"^%s(\.\d+)?$" % re.escape(r["name"]), r["slot"])
                for r in recs)
            for ts, recs in cleanup.items()):
        return "cleanup holds a run that is not {timestamp: [{harness, name, slot}]}"
    return None


class Lock:
    """One run at a time: a non-blocking flock on the lock file, which records the holder's PID."""

    def __init__(self, path):
        self.path = path
        self.f = None

    def __enter__(self):
        try:
            ensure_dir(os.path.dirname(self.path))
            fd = os.open(self.path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o644)
        except (TreeError, OSError) as e:
            raise PrereqError("cannot open the lock %s: %s" % (tilde(self.path), e))
        self.f = os.fdopen(fd, "r+")
        try:
            fcntl.flock(self.f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            self.f.seek(0)
            pid = self.f.read().strip() or "unknown"
            self.f.close()
            raise PrereqError("another agent-sync run holds the lock %s (PID %s)"
                              % (tilde(self.path), pid))
        self.f.seek(0)
        self.f.truncate()
        self.f.write("%d\n" % os.getpid())
        self.f.flush()
        return self

    def __exit__(self, *exc):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


# ── Tree: digest, copy, stage, swap, rollback ─────────────────────────────────────────────────

class SymlinkError(Exception):
    pass


class TreeError(Exception):
    pass


_rename = os.rename  # replaced by tests to inject failures


def digest_tree(root):
    """SHA-256 over sorted relative paths and file bytes, skipping names that begin with `.`.

    Returns (hexdigest, file count). A symlink anywhere fails: copying it would put a symlink in
    $HOME, which Rule #1 forbids."""
    if os.path.islink(root):
        raise SymlinkError("%s is a symlink" % tilde(root))
    h = hashlib.sha256()
    count = 0
    files = []
    for d, dirs, names in os.walk(root):
        for n in list(dirs):
            if os.path.islink(os.path.join(d, n)):
                raise SymlinkError("symlink in source: %s"
                                   % os.path.relpath(os.path.join(d, n), root))
        dirs[:] = sorted(n for n in dirs if not n.startswith("."))
        for n in names:
            p = os.path.join(d, n)
            if os.path.islink(p):
                raise SymlinkError("symlink in source: %s" % os.path.relpath(p, root))
            if not n.startswith("."):
                files.append(os.path.relpath(p, root))
    for rel in sorted(files):
        h.update(rel.encode() + b"\0")
        with open(os.path.join(root, rel), "rb") as f:
            h.update(hashlib.sha256(f.read()).digest())
        count += 1
    return h.hexdigest(), count


def tree_files(root):
    """{relative path: bytes} for a tree, dot names skipped (for cleanup's comparison)."""
    out = {}
    for d, dirs, names in os.walk(root):
        dirs[:] = [n for n in dirs if not n.startswith(".")]
        for n in names:
            if not n.startswith("."):
                p = os.path.join(d, n)
                with open(p, "rb") as f:
                    out[os.path.relpath(p, root)] = f.read()
    return out


_critical = {"depth": 0, "pending": False}


@contextlib.contextmanager
def critical():
    """Defer SIGINT until the outermost block ends, so a swap and its state record finish, or
    roll back, together (spec §6, §10). Nested blocks join the outer one."""
    outer = _critical["depth"] == 0 and threading.current_thread() is threading.main_thread()
    if outer:
        previous = signal.getsignal(signal.SIGINT)
        signal.signal(signal.SIGINT, lambda *_: _critical.update(pending=True))
    _critical["depth"] += 1
    try:
        yield
    finally:
        _critical["depth"] -= 1
        if outer:
            signal.signal(signal.SIGINT, previous)
            if _critical["pending"]:
                _critical["pending"] = False
                raise KeyboardInterrupt


def unique(path):
    candidate, n = path, 1
    while os.path.lexists(candidate):
        n += 1
        candidate = "%s.%d" % (path, n)
    return candidate


def remove_if_empty(path):
    with contextlib.suppress(OSError):
        os.rmdir(path)


def install_tree(src, dest, stage_root, archive_dest):
    """Copy src to dest through a staged, verified copy and two renames (spec §6 steps 4-6).

    Returns {"digest", "files", "archived"}; raises TreeError, after rolling back, if the copy
    cannot be put in place, naming every path that holds something. Every directory written
    through is checked for symlinks first."""
    name = os.path.basename(dest)
    try:
        digest, files = digest_tree(src)
    except SymlinkError as e:
        raise TreeError(str(e))
    stage = os.path.join(ensure_dir(stage_root), "%s.%d" % (name, os.getpid()))
    ensure_dir(os.path.dirname(dest))
    if os.path.lexists(stage):
        shutil.rmtree(stage)
    try:
        shutil.copytree(src, stage, ignore=lambda d, names: [n for n in names
                                                             if n.startswith(".")])
        if digest_tree(stage)[0] != digest:
            raise TreeError("the staged copy of %s does not match its source" % name)
    except (OSError, SymlinkError, TreeError) as e:
        shutil.rmtree(stage, ignore_errors=True)
        remove_if_empty(stage_root)
        raise TreeError(str(e))
    archived = None

    def drop_stage():
        shutil.rmtree(stage, ignore_errors=True)
        remove_if_empty(stage_root)

    with critical():
        if os.path.lexists(dest):
            try:
                ensure_dir(os.path.dirname(archive_dest))
                archived = relocate(dest, unique(archive_dest))
            except TreeError:
                drop_stage()
                raise
        try:
            _rename(stage, dest)
        except OSError as e:
            if archived is None:
                drop_stage()
                raise TreeError("cannot put %s in place: %s" % (tilde(dest), e))
            try:
                _rename(archived, dest)     # back where it came from, on the same volume
            except OSError as e2:
                raise TreeError("cannot put the new copy in place (%s) or restore the old one "
                                "(%s): the old copy is at %s, the new one at %s"
                                % (e, e2, archived, stage))
            drop_stage()
            raise TreeError("cannot put the new copy in place (%s); the previous copy is "
                            "restored" % e)
    remove_if_empty(stage_root)
    return {"digest": digest, "files": files, "archived": archived}


def relocate(src, dst):
    """The one way agent-sync moves a folder: a single rename onto an empty folder it has just
    claimed, so nothing is replaced. Never a copy: across volumes the move fails and nothing is
    touched (spec §10, no cross-volume moves). Returns dst; raises TreeError."""
    claim(dst)
    try:
        _rename(src, dst)
    except OSError as e:
        remove_if_empty(dst)
        if e.errno == errno.EXDEV:
            raise TreeError("cannot move %s to %s: they are on different volumes, and "
                            "agent-sync never copies a folder across volumes; keep "
                            "XDG_STATE_HOME on the home volume" % (tilde(src), tilde(dst)))
        raise TreeError("cannot move %s to %s: %s" % (tilde(src), tilde(dst), e))
    return dst


def claim(path):
    """Create path as an empty folder, failing if anything is already there."""
    try:
        os.mkdir(path)
    except FileExistsError:
        raise TreeError("%s appeared while agent-sync was moving to it; nothing was replaced"
                        % tilde(path))


def move_exact(src, dst, harness_side=None, verify=None):
    """Rename a folder to exactly dst. The chain on agent-sync's side is checked for symlinks at
    the move; the side in a harness's folder ("src" or "dst") is that harness's to point where
    it likes (spec §10, whose symlinks). dst must not exist."""
    if harness_side != "src":
        ensure_dir(os.path.dirname(src), create=False)
    if harness_side == "dst":
        os.makedirs(os.path.dirname(dst), exist_ok=True)
    else:
        ensure_dir(os.path.dirname(dst))
    if os.path.islink(src) or not os.path.isdir(src):
        raise TreeError("%s is a symlink or not a folder; not moved" % tilde(src))
    if verify:
        verify()        # the last look before the rename (spec §10, a move is checked)
    with critical():
        return relocate(src, dst)


def archive_tree(path, archive_dest, harness_side=None, verify=None):
    """Move a folder into the archive, under the first free slot name."""
    return move_exact(path, unique(archive_dest), harness_side, verify)


# ── Report ────────────────────────────────────────────────────────────────────────────────────

CHANGED = ("installed", "updated", "copied", "enabled", "archived")
QUIET = ("unchanged", "live", "external", "unmanaged", "available")   # not drift for --check
WARNINGS = ("duplicate", "unmanaged", "available", "unverifiable", "external", "orphaned")
SUMMARY = ("unchanged", "live", "held", "stale", "duplicate", "failed")
SUMMARY_EXTRA = ("unverifiable", "source-mismatch", "ref-mismatch", "orphaned", "unchecked",
                 "unknown", "skipped")
TO_STDERR = ("failed", "stale", "held", "source-mismatch", "ref-mismatch", "unverifiable",
             "duplicate", "orphaned")
COLUMNS = (9, 39, 13)
ITEM_MAX = 35


@dataclass
class Row:
    harness: str
    item: str
    result: str
    detail: str = ""
    extra: dict = field(default_factory=dict)
    note: str = ""      # e.g. "not installed" for skipped; affects --check only

    def line(self):
        item = self.item if len(self.item) <= ITEM_MAX else self.item[:ITEM_MAX - 1] + "…"
        detail = self.detail.split("\n")
        first = "%-*s%-*s%-*s%s" % (COLUMNS[0], self.harness, COLUMNS[1], item, COLUMNS[2],
                                    self.result, detail[0])
        indent = " " * (sum(COLUMNS) + 2)
        return "\n".join([first.rstrip()] + [indent + d for d in detail[1:]])


class Report:
    def __init__(self):
        self.rows = []

    def add(self, harness, item, result, detail="", **extra):
        note = extra.pop("note", "")
        row = Row(harness, item, result, detail, extra, note)
        self.rows.append(row)
        return row

    def count(self, *results):
        return sum(1 for r in self.rows if r.result in results)

    def exit_code(self, check=False, interrupted=False):
        if interrupted:
            return EXIT_INTERRUPTED
        if check:
            drift = [r for r in self.rows if r.result not in QUIET
                     and not (r.result == "skipped" and r.note == "not installed")]
            return EXIT_FAILED if drift else EXIT_OK
        if self.count("failed", "stale", "source-mismatch", "ref-mismatch"):
            return EXIT_FAILED
        if self.count("held"):
            return EXIT_HELD
        return EXIT_OK

    def table(self):
        head = "%-*s%-*s%-*s%s" % (COLUMNS[0], "HARNESS", COLUMNS[1], "ITEM", COLUMNS[2],
                                   "RESULT", "DETAIL")
        return "\n".join([head] + [r.line() for r in self.rows])

    def summary_counts(self):
        counts = {"changed": self.count(*CHANGED)}
        for k in SUMMARY + SUMMARY_EXTRA + ("external", "unmanaged", "available"):
            counts[k] = self.count(k)
        return counts

    def footer(self, check=False, interrupted=False, dry_run=False):
        c = self.summary_counts()
        parts = ["%d changed" % c["changed"]] + ["%d %s" % (c[k], k) for k in SUMMARY]
        parts += ["%d %s" % (c[k], k) for k in SUMMARY_EXTRA if c[k]]
        lines = ["Summary: " + " · ".join(parts)]
        nexts = []
        changed = {r.harness for r in self.rows if r.result in CHANGED}
        if "claude" in changed:
            nexts.append("restart Claude Code sessions or run /reload-plugins")
        if "codex" in changed:
            nexts.append("restart Codex sessions")
        if "agy" in changed:
            nexts.append("run /skills reload in agy")
        if nexts:
            lines.append(wrap("Next:    ", " · ".join(nexts), " · "))
        code = self.exit_code(check, interrupted)
        lines.append("Exit %d%s" % (code, exit_reason(code, check, dry_run, c)))
        return "\n".join(lines)

    def json_lines(self, code):
        out = []
        for r in self.rows:
            doc = {"harness": r.harness, "item": r.item, "result": r.result, "detail": r.detail}
            doc.update(r.extra)
            out.append(json.dumps(doc, sort_keys=False))
        out.append(json.dumps({"summary": self.summary_counts(), "exit": code}))
        return "\n".join(out) + "\n"


def wrap(prefix, text, sep, width=100):
    lines, current = [], prefix
    for i, part in enumerate(text.split(sep)):
        piece = part + (sep.rstrip() if i < len(text.split(sep)) - 1 else "")
        if len(current) + len(piece) > width and current.strip() != prefix.strip():
            lines.append(current.rstrip())
            current = " " * len(prefix)
        current += piece + " "
    lines.append(current.rstrip())
    return "\n".join(lines)


def exit_reason(code, check, dry_run, counts):
    if code == EXIT_INTERRUPTED:
        return " (interrupted; the report above is partial)"
    if check:
        return " (drift found)" if code else " (no drift)"
    if code == EXIT_HELD:
        return " (held items; nothing failed)"
    if code == EXIT_FAILED:
        reasons = [("failed", "failed"), ("stale", "stale"), ("source-mismatch", "mismatched"),
                   ("ref-mismatch", "mismatched")]
        seen = []
        for key, word in reasons:
            if counts.get(key) and word not in seen:
                seen.append(word)
        return " (%s items)" % " and ".join(seen)
    return " (dry run; nothing was changed)" if dry_run else ""


# ── Command line ──────────────────────────────────────────────────────────────────────────────

def accept_command(value):
    pid, sep, sha = value.partition("=")
    if not sep or "@" not in pid or not re.match(r"^[0-9a-f]{64}$", sha):
        raise argparse.ArgumentTypeError("expected <plugin>@<marketplace>=<sha256>, got %r"
                                         % value)
    return pid, sha


def only_list(value):
    names = [v.strip() for v in value.split(",") if v.strip()]
    bad = [n for n in names if n not in HARNESSES]
    if bad or not names:
        raise argparse.ArgumentTypeError("--only takes a comma list of %s" % ", ".join(HARNESSES))
    return tuple(h for h in HARNESSES if h in names)


def parse_args(argv):
    if argv[:1] == ["cleanup"]:
        p = argparse.ArgumentParser(prog="agent-sync cleanup",
                                    description="Archive flat skill copies that shadow a plugin.")
        p.add_argument("--dry-run", action="store_true", help="list the candidates and stop")
        p.add_argument("--yes", nargs="+", metavar="NAME", default=[],
                       help="archive exactly these candidates without asking")
        p.add_argument("--restore", metavar="TIMESTAMP", help="undo one cleanup run")
        p.add_argument("--manifest", metavar="PATH")
        args = p.parse_args(argv[1:])
        args.command = "cleanup"
        return args
    p = argparse.ArgumentParser(
        prog="agent-sync",
        description="Bring agent plugins and skills up to date in every harness.",
        epilog="agent-sync cleanup [--dry-run] [--yes NAME…] [--restore TIMESTAMP]: the one-time "
               "cleanup of flat copies that shadow a plugin.")
    p.add_argument("--version", action="version", version="agent-sync " + VERSION)
    mode = p.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true", help="print the plan; write nothing")
    mode.add_argument("--check", action="store_true", help="report drift; exit 1 if any")
    p.add_argument("--only", type=only_list, metavar="H[,H…]", help="restrict to these harnesses")
    p.add_argument("--json", action="store_true", help="the report as JSON lines")
    p.add_argument("--accept-command", type=accept_command, action="append", default=[],
                   metavar="PLUGIN@MKT=SHA256", help="accept one declared command (repeatable)")
    p.add_argument("--adopt", action="append", default=[], metavar="SKILL",
                   help="take over a foreign or edited agy folder, archiving it (repeatable)")
    p.add_argument("--prune", action="store_true", help="archive owned agy skills that left "
                                                        "the manifest")
    p.add_argument("--repair", action="store_true", help="reinstall Codex plugins whose cache "
                                                         "is stale")
    p.add_argument("--manifest", metavar="PATH")
    args = p.parse_args(argv)
    args.command = "sync"
    return args


class Context:
    """One run: the arguments, the manifest, the paths, and what the run has found so far."""

    def __init__(self, args, manifest, paths):
        self.args, self.manifest, self.paths = args, manifest, paths
        self.dry_run = bool(getattr(args, "dry_run", False))
        self.check = bool(getattr(args, "check", False))
        self.apply = not (self.dry_run or self.check)
        self.fetch = not self.dry_run          # --check fetches into agent-sync's own cache
        self.harnesses = getattr(args, "only", None) or manifest.harnesses
        self.only = bool(getattr(args, "only", None))
        self.accept = dict(getattr(args, "accept_command", []) or [])
        self.adopt = set(getattr(args, "adopt", []) or [])
        self.runner = Runner()
        self.report = Report()
        self.state = State(paths.state)
        self.ts = timestamp()
        self.sources = {}      # memo: one resolved tree per marketplace source per run
        self.catalogs = {}     # memo: tree -> Catalog
        self.selected = {}     # harness -> {skill name: (plugin id, path)} for duplicates/cleanup

    def save_state(self, pending=""):
        """Write the state file. A failure is a row naming the paths, never fatal to the
        report (spec §10). Returns whether the state on disk is now current."""
        if not self.apply:
            return True
        try:
            self.state.save()
            return True
        except (OSError, TreeError) as e:
            if pending or not self.save_failed:
                self.report.add("-", "state file", "failed", "the state file could not be "
                                "written: %s (%s)%s" % (tilde(self.paths.state), e,
                                                        "; not recorded: " + pending
                                                        if pending else ""))
            self.save_failed = True
            return False

    save_failed = False

    def applied(self, harness):
        return self.state.data["applied"].setdefault(harness, {})


SYNC_STEPS = []   # each takes the Context; filled in below, in the order they run


def run_sync(ctx):
    for step in SYNC_STEPS:
        try:
            step(ctx)
        except ITEM_ERRORS as e:        # one harness's surprise never stops the others (§10)
            h = step.__name__.partition("sync_")[2] or "-"
            ctx.report.add(h, "%s CLI" % h if h != "-" else step.__name__, "failed",
                           "stopped on unexpected input: %s: %s" % (type(e).__name__, e))


def print_report(ctx, interrupted=False):
    code = ctx.report.exit_code(ctx.check, interrupted)
    if ctx.args.json:
        sys.stdout.write(ctx.report.json_lines(code))
    else:
        sys.stdout.write("agent-sync %s · manifest %s%s\n\n%s\n\n%s\n" % (
            VERSION, tilde(ctx.manifest.path),
            " · dry run" if ctx.dry_run else " · check" if ctx.check else "",
            ctx.report.table(), ctx.report.footer(ctx.check, interrupted, ctx.dry_run)))
    for row in ctx.report.rows:
        if row.result in TO_STDERR:
            sys.stderr.write(row.line() + "\n")
    return code


def prepare(args):
    """The manifest and paths, validated, or UsageError. Nothing is read from the state yet."""
    path = args.manifest or default_manifest_path()
    manifest = load_manifest(os.path.abspath(os.path.expanduser(path)))
    run_harnesses = getattr(args, "only", None) or manifest.harnesses
    check_manifest_paths(manifest, run_harnesses)
    for pid, _ in getattr(args, "accept_command", []) or []:
        if pid not in manifest.plugins and pid.partition("@")[2] not in manifest.marketplaces:
            raise UsageError("--accept-command names %s, which the manifest does not manage" % pid)
    if args.command == "sync":
        check_prerequisites(manifest, run_harnesses)
    return manifest, Paths()


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    args = parse_args(argv)
    try:
        manifest, paths = prepare(args)
        # The lock comes first: the state is read, and cleanup's candidates computed, only
        # while this run holds it (spec §10).
        with (contextlib.nullcontext() if args.dry_run else Lock(paths.lock)):
            ctx = Context(args, manifest, paths)
            interrupted, code = False, EXIT_OK
            try:
                if args.command == "cleanup":
                    code = run_cleanup(ctx)
                else:
                    run_sync(ctx)
            except KeyboardInterrupt:
                interrupted = True
            finally:
                ctx.save_state()
                if not args.dry_run:
                    with contextlib.suppress(OSError, TreeError):
                        ctx.runner.write_log(paths.log)
            if args.command != "cleanup":
                return print_report(ctx, interrupted)
            for row in ctx.report.rows:     # a state file that could not be written (spec §10)
                print(row.line())
            return EXIT_INTERRUPTED if interrupted else EXIT_FAILED if ctx.report.rows else code
    except UsageError as e:
        sys.stderr.write("agent-sync: %s\n" % e)
        return EXIT_USAGE
    except PrereqError as e:
        sys.stderr.write("agent-sync: %s\n" % e)
        return EXIT_PREREQ


def check_prerequisites(manifest, harnesses):
    """Exit 4 before anything runs when a Git source needs git and there is none."""
    needs_git = []
    for m in manifest.marketplaces.values():
        if any(m.source[h] == "git" for h in manifest.harnesses_using(m) if h in harnesses):
            needs_git.append("marketplace %s" % m.name)
    if "agy" in harnesses:
        needs_git += ["skill %s" % s.name for s in manifest.skills if s.git]
    if needs_git and shutil.which("git") is None:
        raise PrereqError("git is not on PATH, and %s needs it" % ", ".join(needs_git))


# ── Sources: checkouts and agent-sync's own Git cache (spec §6) ───────────────────────────────

@dataclass
class Source:
    kind: str                 # "checkout", "git" or "path"
    tree: str = None          # None when not available in this run
    revision: str = None
    dirty: bool = False
    before: str = None        # git: the cache's revision before this run fetched
    error: str = None
    reported: bool = False    # its error is already in the report

    def label(self):
        if self.kind == "checkout":
            return "%s (%s)" % ((self.revision or "no HEAD")[:7], "dirty" if self.dirty
                                else "clean")
        return (self.revision or "")[:7]


def git_url(value):
    """owner/repo is a GitHub repository; anything else is a Git URL already."""
    if re.match(r"^[\w.-]+/[\w.-]+$", value):
        return "https://github.com/%s.git" % value
    return value


def normalize_git(value):
    """A comparable form of a Git source: host/path, no scheme, user, ref or .git suffix."""
    v = git_url(value.strip()).split("#")[0]
    m = re.match(r"^[\w.-]+@([\w.-]+):(.*)$", v)
    if m:
        v = m.group(1) + "/" + m.group(2)
    v = re.sub(r"^[a-z+]+://", "", v)
    v = re.sub(r"^[^/@]+@", "", v)
    v = re.sub(r"(\.git)?/*$", "", v)
    host, _, path = v.partition("/")
    return host.lower() + "/" + path


def same_path(a, b):
    return bool(a and b) and os.path.realpath(a) == os.path.realpath(b)


def checkout_source(ctx, path):
    key = ("checkout", path)
    if key not in ctx.sources:
        src = Source("checkout", tree=path)
        if shutil.which("git"):
            head = ctx.runner.run(["git", "-C", path, "rev-parse", "HEAD"], GIT_TIMEOUT)
            src.revision = head.stdout.strip() if head.ok else None
            status = ctx.runner.run(["git", "-C", path, "--no-optional-locks", "status",
                                     "--porcelain"], GIT_TIMEOUT)
            src.dirty = status.ok and bool(status.stdout.strip())
        ctx.sources[key] = src
    return ctx.sources[key]


def cache_name(kind, url, ref):
    """A Git source's cache folder, named by the request rather than by any name, so no two
    sources share one, whatever the volume's case rules (spec §10)."""
    return hashlib.sha256(("%s\n%s\n%s" % (kind, url, ref or "")).encode()).hexdigest()


def git_source(ctx, kind, url, ref):
    """agent-sync's own clone of a Git source, moved to `ref` (never a harness's cache). Every
    command names the repository and worktree explicitly, and links are checked out as plain
    files (core.symlinks=false), so no tracked symlink lands in $HOME (spec §6)."""
    key = cache_name(kind, url, ref)
    if key in ctx.sources:
        return ctx.sources[key]
    d = os.path.join(ctx.paths.sources, key)
    git = ["git", "--git-dir", os.path.join(d, ".git"), "--work-tree", d,
           "-c", "core.symlinks=false"]
    run = lambda *a: ctx.runner.run(git + list(a), GIT_TIMEOUT)  # noqa: E731
    src = Source("git")
    ctx.sources[key] = src
    meta = os.path.join(d, ".git")
    if os.path.islink(d) or os.path.lexists(meta) and (os.path.islink(meta) or
                                                       not os.path.isdir(meta)):
        src.error = "%s is a symlink or holds redirected Git metadata; delete it to " \
                    "start over" % tilde(d)
        return src
    if os.path.isdir(meta):
        r = run("rev-parse", "HEAD")
        src.before = r.stdout.strip() if r.ok else None
    if not ctx.fetch:
        src.tree, src.revision = (d, src.before) if src.before else (None, None)
        return src
    try:
        ensure_dir(ctx.paths.sources)
    except TreeError as e:
        src.error = str(e)
        return src
    if not os.path.isdir(d):
        r = ctx.runner.run(["git", "-c", "core.symlinks=false", "clone", "--no-checkout", "--",
                            url, d], GIT_TIMEOUT)
        if not r.ok:
            src.error = "cannot clone %s: %s" % (redact(url), r.error())
            return src
    for args in (("fetch", "--tags", "origin", ref or "HEAD"),
                 ("checkout", "--detach", "FETCH_HEAD"), ("rev-parse", "HEAD")):
        r = run(*args)
        if not r.ok:
            src.error = "cannot %s %s at %s: %s" % (args[0], redact(url), ref or "HEAD",
                                                     r.error())
            return src
    src.tree, src.revision = d, r.stdout.strip()
    return src


def marketplace_source(ctx, m, harness):
    if m.source[harness] == "checkout":
        return checkout_source(ctx, m.checkout)
    return git_source(ctx, "marketplace", git_url(m.git), m.ref)


# ── Catalog: plugins, enrolment and skills (spec §3, §6) ──────────────────────────────────────

class CatalogError(Exception):
    pass


@dataclass
class Skill:
    name: str
    path: str
    plugin: str = None        # plugin id, or None for a [[skill]]
    error: str = None


class Catalog:
    def __init__(self, tree):
        self.tree = tree
        path = os.path.join(tree, ".claude-plugin", "marketplace.json")
        try:
            with open(path) as f:
                doc = json.load(f)
            self.name = doc["name"]
            self.root = (doc.get("metadata") or {}).get("pluginRoot") or ""
            plugins = doc.get("plugins", [])
            if not (isinstance(self.name, str) and isinstance(self.root, str) and
                    isinstance(plugins, list) and all(isinstance(e, dict) and
                                                      isinstance(e.get("name"), str)
                                                      for e in plugins)):
                raise TypeError("unexpected types in name, metadata.pluginRoot or plugins")
        except (OSError, ValueError, KeyError, TypeError, AttributeError) as e:
            raise CatalogError("cannot read %s: %s" % (tilde(path), e))
        # A name that could be read as an option never reaches a CLI (spec §4).
        self.entries = {e["name"]: e for e in plugins if NAME.match(e["name"])}
        self.bad = sorted(e["name"] for e in plugins if not NAME.match(e["name"]))

    def plugin_dir(self, name):
        src = self.entries[name].get("source")
        if not isinstance(src, str):
            return None
        if not src.startswith("./") and src not in (".", "./") and self.root:
            src = os.path.join(self.root, src)
        return self.inside(src)

    def inside(self, rel, base=None):
        if not isinstance(rel, str):
            raise CatalogError("a path in the catalog is not a string: %r" % (rel,))
        return contained(self.tree, os.path.join(base or self.tree, rel))

    def skills(self, name):
        """The plugin's skills: the declared `skills` paths (catalog entry, else plugin.json),
        defaulting to every <plugin>/skills/*/SKILL.md."""
        pid = "%s@%s" % (name, self.name)
        pdir = self.plugin_dir(name)
        if pdir is None:
            raise CatalogError("its source is outside the catalog, so its skills cannot be read")
        found = []
        for d in skill_folders(pdir, self.entries[name].get("skills"),
                               lambda rel: self.inside(rel, pdir)):
            self.inside(os.path.relpath(d, self.tree))
            n = os.path.basename(d)
            found.append(Skill(n, d, pid, front_matter_error(d) if NAME.match(n) else
                               "%r is not a name agent-sync can record; not copied" % n))
        return found


def skill_folders(pdir, declared, inside):
    """The skill folders a plugin selects: the declared `skills` paths (catalog entry, else its
    plugin.json), defaulting to every <plugin>/skills/*/SKILL.md. Only a plugin.json that does
    not exist means "no declaration"; one that cannot be read is an error, since a selection
    read wrongly looks like a removal to prune. Links are never read; the catalog walk in
    agy_selection reports them (spec §10)."""
    descriptor = os.path.join(pdir, DESCRIPTOR)
    if declared is None and os.path.lexists(descriptor):
        try:
            with open(descriptor) as f:
                doc = json.load(f)
        except (OSError, ValueError) as e:
            raise CatalogError("its plugin.json cannot be read: %s" % e)
        if not isinstance(doc, dict):
            raise CatalogError("its plugin.json is not a JSON object")
        declared = doc.get("skills")
    if declared is not None and not isinstance(declared, (str, list)):
        raise CatalogError("its skills field is neither a path nor a list of paths")

    def listing(base):
        return [os.path.join(base, n) for n in sorted(os.listdir(base))
                if not os.path.islink(os.path.join(base, n))]

    if declared is None:
        base = os.path.join(pdir, "skills")
        if os.path.islink(base):
            raise CatalogError("its skills folder is a symlink; nothing is read through it")
        dirs = listing(base) if os.path.isdir(base) else []
    else:
        dirs = []
        for rel in [declared] if isinstance(declared, str) else declared:
            p = inside(rel)
            if os.path.isfile(os.path.join(p, "SKILL.md")):
                dirs.append(p)
            elif os.path.isdir(p):
                dirs += listing(p)
            else:
                raise CatalogError("declared skills path %s does not exist" % rel)
    return [d for d in dirs if os.path.isfile(os.path.join(d, "SKILL.md"))]


def contained(root, path):
    """path, normalised, if it lies inside root with no symlink between root and it, so no
    link can bring in a tree from elsewhere (spec §6). Raises CatalogError."""
    p = os.path.normpath(path)
    if p != root and not p.startswith(root.rstrip("/") + "/"):
        raise CatalogError("%s points outside %s" % (path, tilde(root)))
    current = root
    for part in [x for x in os.path.relpath(p, root).split(os.sep) if x != "."]:
        current = os.path.join(current, part)
        if os.path.islink(current):
            raise CatalogError("%s is a symlink; nothing is read through it"
                               % os.path.relpath(current, root))
    return p


def front_matter_error(skill_dir):
    """A skill's folder name must equal the `name:` in its SKILL.md front matter."""
    name = os.path.basename(skill_dir)
    try:
        with open(os.path.join(skill_dir, "SKILL.md"), encoding="utf-8") as f:
            text = f.read()
    except (OSError, UnicodeDecodeError) as e:
        return "cannot read SKILL.md: %s" % e
    m = re.match(r"^---\s*\n(.*?)\n---", text, re.S)
    found = re.search(r"^name:\s*(.*?)\s*$", m.group(1), re.M) if m else None
    declared = found.group(1).strip("'\"") if found else None
    if declared != name:
        return "folder %s but its front matter says name: %s" % (name, declared)
    return None


def catalog_for(ctx, m, src):
    """The catalog in a source tree, its name checked against the manifest. None if absent."""
    if src.tree is None:
        return None
    if src.tree not in ctx.catalogs:
        cat = Catalog(src.tree)
        if cat.name != m.name:
            raise CatalogError("the catalog at %s is named %s, not %s"
                               % (tilde(src.tree), cat.name, m.name))
        ctx.catalogs[src.tree] = cat
    return ctx.catalogs[src.tree]


@dataclass
class Enrolled:
    id: str
    name: str
    agy_skills: tuple = None


def enrol(ctx, m, harness, cat):
    """Plugins of marketplace m enrolled for a harness, and (id, reason) for rows that fail."""
    rows = [r for r in ctx.manifest.plugins.values() if r.marketplace == m.name]
    failed, enrolled = [], []
    if cat is None:   # dry run, catalog not fetched: rows only, unverified
        return [Enrolled(r.id, r.name, r.agy_skills) for r in rows
                if harness in r.harnesses and m.plugins == "listed"], failed
    for r in rows:
        if r.name not in cat.entries and harness in r.harnesses:
            failed.append((r.id, "the catalog at %s has no plugin %s" % (
                (cat_label(ctx, m, harness)), r.name)))
    if m.plugins == "all":
        failed += [("%r@%s" % (n, m.name), "a catalog plugin name a harness will not take; "
                    "not passed to any CLI") for n in cat.bad]
        by_name = {r.name: r for r in rows}
        for name in cat.entries:
            row = by_name.get(name)
            if name in m.exclude or harness not in (row.harnesses if row else m.harnesses):
                continue
            enrolled.append(Enrolled("%s@%s" % (name, m.name), name,
                                     row.agy_skills if row else None))
    else:
        enrolled = [Enrolled(r.id, r.name, r.agy_skills) for r in rows
                    if harness in r.harnesses and r.name in cat.entries]
    return enrolled, failed


def cat_label(ctx, m, harness):
    src = marketplace_source(ctx, m, harness)
    return "checkout %s" % tilde(m.checkout) if src.kind == "checkout" else \
        "%s %s" % (m.ref or "default branch", src.label())


def marketplaces_for(ctx, harness):
    return [m for m in ctx.manifest.marketplaces.values()
            if m.source[harness] != "none" and harness in ctx.manifest.harnesses_using(m)]


def resolve_marketplace(ctx, m, harness):
    """(Source, Catalog) for a harness, or (None, None) with a failed/skipped row added."""
    src = marketplace_source(ctx, m, harness)
    item = "marketplace %s" % m.name
    if src.error:
        if src.reported:
            ctx.report.add(harness, item, "skipped", "its Git source failed above")
        else:
            src.reported = True
            ctx.report.add(harness, item, "failed", src.error)
        return None, None
    try:
        return src, catalog_for(ctx, m, src)
    except CatalogError as e:
        ctx.report.add(harness, item, "failed", str(e))
        return None, None


def harness_present(ctx, harness):
    if shutil.which(harness):
        return True
    if ctx.only:
        ctx.report.add(harness, "%s CLI" % harness, "failed",
                       "not installed, and named in --only")
    else:
        ctx.report.add(harness, "%s CLI" % harness, "skipped", "not installed",
                       note="not installed")
    return False


def planned(ctx, harness, item, argv, why=""):
    argv = [redact(a) for a in argv]
    ctx.report.add(harness, item, "unchecked", "%swould run: %s" % (why, " ".join(argv)),
                   argv=argv)


def skip_plugins(ctx, harness, plugins, why):
    for e in plugins:
        ctx.report.add(harness, e.id, "skipped", why)


def held_shown(doc):
    """The shownCommand of a held declared command (C4), or None."""
    if doc and doc.get("failureCode") == "command_source_refused":
        shown = doc.get("shownCommand")
        if isinstance(shown, dict) and re.match(r"^[0-9a-f]{64}$", str(shown.get("sha256"))):
            return shown
    return None


def add_held(ctx, harness, pid, shown):
    first = "declared command awaits confirmation:"
    if shown.get("acceptCommandMatched") is False:
        first = "the hash given was refused (the command or the catalog changed); " + first
    ctx.report.add(harness, pid, "held", "%s\n`%s`\nre-run with --accept-command %s=%s"
                   % (first, shown.get("command", "?"), pid, shown["sha256"]),
                   sha256=shown["sha256"], command=shown.get("command"))


def revision_detail(m, before, after):
    ref = m.ref or "default branch"
    if before and after and before != after:
        return "%s: %s → %s" % (ref, before[:7], after[:7])
    return "%s: %s" % (ref, (after or "")[:7])


# ── Claude Code (spec §5.1) ───────────────────────────────────────────────────────────────────

def claude_list(ctx, what):
    argv = ["claude", "plugin"] + (["marketplace"] if what == "marketplaces" else []) + \
        ["list", "--json"]
    r = ctx.runner.run(argv, extra_env=CLAUDE_LIST_ENV)
    doc = json_document(r.stdout) if r.ok else None
    if not isinstance(doc, list):
        ctx.report.add("claude", "claude CLI", "failed", "cannot read its %s: %s"
                       % (what, r.error() if not r.ok else "unexpected output"))
        return None
    key = "id" if what == "plugins" else "name"
    bad = [x for x in doc if not isinstance(x, dict) or not isinstance(x.get(key), str) or
           not isinstance(x.get("scope", "user"), str) or
           not isinstance(x.get("enabled", True), bool)]
    if bad:                 # one entry of the wrong shape: nothing it lists is trusted (§10)
        ctx.report.add("claude", "claude CLI", "failed", "cannot read its %s: an entry has no "
                       "string %s, or fields of the wrong type: %s"
                       % (what, key, json.dumps(bad[0])[:120]))
        return None
    if what == "plugins":
        return {p["id"]: p for p in doc if p.get("scope", "user") == "user" and
                not p["id"].endswith("@builtin")}
    return {mk["name"]: mk for mk in doc}


def claude_source_arg(m):
    if m.source["claude"] == "checkout":
        return m.checkout
    # C-probe 2026-11-27: Claude takes a ref as a `#<ref>` suffix and lists it back as "ref".
    return m.git + ("#" + m.ref if m.ref else "")


def claude_marketplace(ctx, m, src, observed, state):
    """Add, compare or refresh one marketplace. Returns True when its plugins may proceed."""
    h, item = "claude", "marketplace %s" % m.name
    add = ["claude", "plugin", "marketplace", "add", "--scope", "user", "--json",
           claude_source_arg(m)]
    if observed is None:
        if not ctx.apply:
            planned(ctx, h, item, add)
            return True
        r = ctx.runner.run(add)
        doc = json_last_line(r.stdout)
        if not r.ok or not doc or doc.get("outcome") != "ok":
            ctx.report.add(h, item, "failed", r.error())
            return False
        if doc.get("marketplace") not in (None, m.name):
            ctx.report.add(h, item, "failed", "added, but it is named %s" % doc["marketplace"])
            return False
        state[m.name] = {"revision": src.revision} if m.source[h] == "git" else \
            {"digest": checkout_digest(m.checkout)}
        ctx.report.add(h, item, "installed", "added from %s%s" % (
            tilde(redact(claude_source_arg(m))), ", " + src.label() if src.revision else ""))
        return True
    kind = observed.get("source")
    have = observed.get("url") or observed.get("repo") or observed.get("path")
    if m.source[h] == "checkout":
        matches = kind == "directory" and same_path(have, m.checkout)
        want = m.checkout
    else:
        matches = kind in ("git", "github", "url") and have and \
            normalize_git(have) == normalize_git(m.git)
        want = git_url(m.git)
    if kind not in ("directory", "git", "github", "url") or not isinstance(have, str) or \
            not isinstance(observed.get("ref"), (str, type(None))):
        return unverifiable(ctx, h, item, "Claude lists it with a source shape agent-sync does "
                                          "not recognise")
    if not matches:
        return mismatch(ctx, h, item, "source", "Claude has %s, the manifest says %s"
                        % (have, want), ["claude plugin marketplace remove " + m.name, add])
    if m.source[h] == "git" and (observed.get("ref") or None) != m.ref:
        return mismatch(ctx, h, item, "ref", "Claude follows %s, the manifest says %s"
                        % (observed.get("ref") or "the default branch",
                           m.ref or "the default branch"),
                        ["claude plugin marketplace remove " + m.name, add])
    if m.source[h] == "checkout":
        digest = checkout_digest(m.checkout)
        last = (state.get(m.name) or {}).get("digest")
        state[m.name] = {"digest": digest}
        ctx.report.add(h, item, "live", "checkout %s, digest %s" % (
            src.label(), "unchanged" if last == digest else "changed" if last else "recorded"))
        return True
    update = ["claude", "plugin", "marketplace", "update", "--json", m.name]
    return git_refresh(ctx, h, m, src, state, update, lambda r: (
        r.ok and (json_last_line(r.stdout) or {}).get("outcome") in (None, "ok"), r.error()),
        " (catalog refreshed)")


def unverifiable(ctx, h, item, why):
    """Source metadata that cannot be compared: nothing is changed on a guess (spec §5)."""
    ctx.report.add(h, item, "unverifiable", why + "; not compared, and its plugins are left as "
                                                  "they are")
    return False


def mismatch(ctx, h, item, what, detail, commands):
    ctx.report.add(h, item, what + "-mismatch", redact(
        "%s; to change it by hand:\n%s" % (detail, "\n".join(
            c if isinstance(c, str) else " ".join(c) for c in commands))))
    return False


def git_refresh(ctx, h, m, src, state, argv, judge, unmoved=""):
    """Refresh a Git marketplace through its harness. The baseline is the revision agent-sync
    last applied, never its own cache, which a --check moves (spec §8)."""
    item = "marketplace %s" % m.name
    last = (state.get(m.name) or {}).get("revision")
    if ctx.dry_run:
        planned(ctx, h, item, argv, "remote not fetched; ")
        return True
    if ctx.check:
        if last is None:
            ctx.report.add(h, item, "unverifiable", "%s; no applied revision recorded, so "
                           "whether %s holds it is unknown; a run records one"
                           % (revision_detail(m, None, src.revision), HARNESS_NAMES[h]))
        elif last == src.revision:
            ctx.report.add(h, item, "unchanged", revision_detail(m, None, src.revision))
        else:
            planned(ctx, h, item, argv, revision_detail(m, last, src.revision) + "; ")
        return True
    r = ctx.runner.run(argv)
    ok, error = judge(r)
    if not ok:
        ctx.report.add(h, item, "failed", error)
        return False
    state[m.name] = dict(state.get(m.name) or {}, revision=src.revision)
    if last is None:
        ctx.report.add(h, item, "updated", revision_detail(m, None, src.revision) +
                       " (first refresh recorded)")
    elif last != src.revision:
        ctx.report.add(h, item, "updated", revision_detail(m, last, src.revision))
    else:
        ctx.report.add(h, item, "unchanged", revision_detail(m, None, src.revision) + unmoved)
    return True


def checkout_digest(path):
    try:
        return digest_tree(path)[0]
    except (SymlinkError, OSError):
        return None


def files(n):
    return "%d file%s" % (n, "" if n == 1 else "s")


def claude_plugin(ctx, m, e, observed, git_moved):
    """Install, update or enable one plugin. Returns its row for the version fill, or None."""
    h = "claude"
    accept = ["--accept-command", ctx.accept[e.id]] if e.id in ctx.accept else []
    if observed is None:
        argv = ["claude", "plugin", "install", "--scope", "user", "--json"] + accept + [e.id]
    elif observed.get("readFromFolder") or (ctx.check and not git_moved):
        argv = None        # read live from its folder (C2), or nothing moved upstream
    else:
        argv = ["claude", "plugin", "update", "--scope", "user", "--json"] + accept + [e.id]
    disabled = observed is not None and not observed.get("enabled", True)
    # A plugin Claude reads from a checkout folder is live: edits need no run (C2, spec §5.1).
    quiet = "live" if observed is not None and observed.get("readFromFolder") else "unchanged"
    if not ctx.apply:
        if argv:
            planned(ctx, h, e.id, argv)
        if disabled:
            planned(ctx, h, e.id, ["claude", "plugin", "enable", "--scope", "user", "--json",
                                   e.id])
        return None if argv or disabled else ctx.report.add(h, e.id, quiet)
    verb, detail = quiet, ""
    if argv:
        r = ctx.runner.run(argv)
        doc = json_last_line(r.stdout)
        shown = held_shown(doc)     # a held command exits 1 like a failure (C4)
        if shown:
            add_held(ctx, h, e.id, shown)
            return None
        if not r.ok or not doc or doc.get("outcome") != "ok":
            ctx.report.add(h, e.id, "failed", r.error())
            return None
        if observed is None:
            verb = "installed"
        elif doc.get("updateOutcome") != "up_to_date" and \
                doc.get("oldVersion") != doc.get("newVersion"):
            verb, detail = "updated", "%s → %s" % (doc.get("oldVersion"), doc.get("newVersion"))
    if disabled:
        if not claude_enable(ctx, e.id):
            return None
        if verb in ("unchanged", "live"):
            verb = "enabled"
    return ctx.report.add(h, e.id, verb, detail)


def claude_enable(ctx, pid):
    r = ctx.runner.run(["claude", "plugin", "enable", "--scope", "user", "--json", pid])
    doc = json_last_line(r.stdout)
    if r.ok and doc and doc.get("outcome") == "ok":
        return True
    ctx.report.add("claude", pid, "failed", "cannot enable: " + r.error())
    return False


ITEM_ERRORS = (CatalogError, TreeError, SymlinkError, OSError, ValueError, TypeError, KeyError,
               AttributeError)


def harness_home(ctx, h):
    """In a dry run or --check, a harness whose home is missing or empty is not called: its
    first command would initialise that home (C1, spec §8). Returns False after the row."""
    path = {"claude": ctx.paths.claude_home, "codex": ctx.paths.codex_home,
            "agy": ctx.paths.gemini_config}[h]
    if ctx.apply or os.path.isdir(path) and set(os.listdir(path)) - {".DS_Store"}:
        return True
    ctx.report.add(h, "%s CLI" % h, "unknown", "home not initialised (%s); not called, since "
                   "its first command would create it" % tilde(path))
    return False


def sync_claude(ctx):
    h = "claude"
    if h not in ctx.harnesses or not harness_present(ctx, h) or not harness_home(ctx, h):
        return
    markets = claude_list(ctx, "marketplaces")
    plugins = claude_list(ctx, "plugins") if markets is not None else None
    if plugins is None:
        return
    state = ctx.applied(h)
    managed, unknown, rows, work, done = set(), set(), [], [], []
    for m in marketplaces_for(ctx, h):      # marketplaces first, then their plugins (spec §10)
        try:
            src, cat = resolve_marketplace(ctx, m, h)
            if src is None or cat is None and m.plugins == "all":
                unknown.add(m.name)
                if src is not None:
                    ctx.report.add(h, "marketplace %s" % m.name, "unchecked", "catalog not "
                                   "fetched yet; its plugins are listed by --check or a run")
                continue
            enrolled, failed = enrol(ctx, m, h, cat)
            proceed = claude_marketplace(ctx, m, src, markets.get(m.name), state)
            ctx.save_state()
        except ITEM_ERRORS as e:
            ctx.report.add(h, "marketplace %s" % m.name, "failed", str(e))
            unknown.add(m.name)
            continue
        managed.update(e.id for e in enrolled)
        work.append((m, src, cat, enrolled, failed, proceed))
    for m, src, cat, enrolled, failed, proceed in work:
        for pid, why in failed:
            ctx.report.add(h, pid, "failed", why)
        if not proceed:
            skip_plugins(ctx, h, enrolled, "marketplace %s needs attention above" % m.name)
            continue
        record = state.get(m.name) or {}
        for e in enrolled:
            # Each plugin's own applied revision, never its marketplace's: one never applied,
            # or held, or failed, is unknown, and --check reports it unchecked (spec §10).
            last = (record.get("plugins") or {}).get(e.id)
            row = claude_plugin(ctx, m, e, plugins.get(e.id), last != src.revision)
            if row is not None:
                rows.append(row)
                if ctx.apply and m.source[h] == "git" and m.name in state:
                    done.append((row, state[m.name], e.id, src.revision))
    if any(r.result in CHANGED for r in rows) and ctx.apply:
        plugins = claude_list(ctx, "plugins") or {}
    for m, _, cat, enrolled, _, proceed in work:    # after the changes: a new install counts
        if proceed:
            record_selection(ctx, h, m, cat, enrolled, plugins)
    for row in rows:
        p = plugins.get(row.item)
        if p is None or not p.get("enabled", True):
            if row.result in CHANGED:
                row.result, row.detail = "failed", "not listed as enabled after the change"
            continue
        info = "%s, enabled, user" % p.get("version", "?")
        row.detail = "%s (%s)" % (info, row.detail) if row.detail else info
    for row, record, pid, revision in done:
        if row.result != "failed":
            record.setdefault("plugins", {})[pid] = revision
    if done:
        ctx.save_state("the applied revisions of Claude's plugins")
    for pid in plugins:
        if pid not in managed and pid.partition("@")[2] not in unknown:
            ctx.report.add(h, pid, "unmanaged", "not in the manifest; left as it is")


def record_selection(ctx, harness, m, cat, enrolled, installed):
    """Remember the skills of enabled managed plugins, with the tree the harness actually loads
    (None when it cannot be found), for duplicates and cleanup (spec §7, §9)."""
    if cat is None:
        return
    sel = ctx.selected.setdefault(harness, {})
    for e in enrolled:
        p = installed.get(e.id)
        if p is None or not p.get("enabled", True):
            continue
        if harness == "claude":
            root = p.get("readFromFolder") or p.get("installPath")
        else:
            root = os.path.join(ctx.paths.codex_home, "plugins", "cache", m.name, e.name,
                                str(p.get("version")))
        with contextlib.suppress(*ITEM_ERRORS):
            pdir = cat.plugin_dir(e.name)
            for s in cat.skills(e.name):
                loaded = os.path.join(root, os.path.relpath(s.path, pdir)) \
                    if isinstance(root, str) else None
                sel.setdefault(s.name, (e.id, s.path, p.get("version"),
                                        loaded if loaded and os.path.isdir(loaded) else None))


# ── Codex (spec §5.2) ─────────────────────────────────────────────────────────────────────────

def codex_refs(ctx):
    """{marketplace: ref} read from Codex's config.toml (read-only), or None if unrecognised."""
    try:
        with open(os.path.join(ctx.paths.codex_home, "config.toml"), "rb") as f:
            doc = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        return None
    tables = doc.get("marketplaces")
    if not isinstance(tables, dict) or not all(isinstance(t, dict) for t in tables.values()):
        return None
    return {name: t.get("ref") for name, t in tables.items()}


def codex_plugins(ctx, name):
    r = ctx.runner.run(["codex", "plugin", "list", "--marketplace", name, "--json"])
    doc = json_document(r.stdout) if r.ok else None
    if not isinstance(doc, dict) or not isinstance(doc.get("installed"), list):
        ctx.report.add("codex", "marketplace %s" % name, "failed",
                       "cannot list its plugins: %s" % (r.error() if not r.ok else "unexpected "
                                                                                     "output"))
        return None
    bad = [p for p in doc["installed"] if not isinstance(p, dict) or
           not isinstance(p.get("pluginId"), str) or
           not isinstance(p.get("version"), (str, type(None))) or
           not isinstance(p.get("enabled", True), bool)]
    if bad:
        ctx.report.add("codex", "marketplace %s" % name, "failed", "cannot list its plugins: an "
                       "entry has fields of the wrong type: %s" % json.dumps(bad[0])[:120])
        return None
    return {p["pluginId"]: p for p in doc["installed"]}


def codex_marketplace(ctx, m, src, observed, refs, state):
    h, item = "codex", "marketplace %s" % m.name
    use_git = m.source[h] == "git"
    add = ["codex", "plugin", "marketplace", "add", "--json"] + \
        (["--ref", m.ref] if use_git and m.ref else []) + [m.git if use_git else m.checkout]
    if observed is None:
        if not ctx.apply:
            planned(ctx, h, item, add)
            return True
        r = ctx.runner.run(add)
        doc = json_document(r.stdout) if r.ok else None
        if not isinstance(doc, dict):
            ctx.report.add(h, item, "failed", r.error())
            return False
        if doc.get("marketplaceName") not in (None, m.name):
            ctx.report.add(h, item, "failed", "added, but it is named %s"
                           % doc["marketplaceName"])
            return False
        state[m.name] = {"revision": src.revision}
        ctx.report.add(h, item, "installed", "added from %s%s" % (
            tilde(redact(add[-1])), ", " + src.label() if src.revision else ""))
        return True
    source = observed.get("marketplaceSource") or {}
    kind, have = source.get("sourceType"), source.get("source")
    if not isinstance(kind, str) or not isinstance(have, str) or not kind or not have:
        return unverifiable(ctx, h, item, "Codex lists it with a source shape agent-sync does "
                                          "not recognise")
    if use_git:
        matches = kind == "git" and normalize_git(have) == normalize_git(m.git)
    else:
        matches = kind != "git" and (same_path(have, m.checkout) or
                                     same_path(observed.get("root"), m.checkout))
    fix = ["codex plugin marketplace remove " + m.name, add]
    if not matches:
        return mismatch(ctx, h, item, "source", "Codex has %s, the manifest says %s"
                        % (have, add[-1]), fix)
    if use_git:
        # The ref is only in config.toml (C5), read and never written. Compared both ways, so
        # a manifest that drops its ref still sees a pin Codex keeps.
        have_ref = (refs or {}).get(m.name, ())
        if have_ref == () or not isinstance(have_ref, (str, type(None))):
            return unverifiable(ctx, h, item, "its ref could not be read from %s"
                                % tilde(os.path.join(ctx.paths.codex_home, "config.toml")))
        if (have_ref or None) != m.ref:
            return mismatch(ctx, h, item, "ref", "Codex follows %s, the manifest says %s "
                            "(installed plugins come back by themselves)"
                            % (have_ref or "the default branch", m.ref or "the default branch"),
                            fix)
    if not use_git:
        ctx.report.add(h, item, "unchanged", "checkout %s; Codex copies plugins at install, "
                                             "so edits show as stale below" % src.label())
        return True
    upgrade = ["codex", "plugin", "marketplace", "upgrade", "--json", m.name]

    def judge(r):
        doc = json_document(r.stdout) if r.ok else None
        if not isinstance(doc, dict):
            return False, r.error()
        return not doc.get("errors"), "; ".join(str(x) for x in doc.get("errors") or [])
    return git_refresh(ctx, h, m, src, state, upgrade, judge)


def skill_dirs(root):
    """Relative paths of the folders holding SKILL.md under root, dot names skipped."""
    out = set()
    for d, dirs, names in os.walk(root):
        dirs[:] = [n for n in dirs if not n.startswith(".")]
        if "SKILL.md" in names:
            out.add(os.path.relpath(d, root))
    return out


def codex_cache_check(ctx, m, cat, name, version):
    """'match', 'stale' or 'unverifiable' for one installed plugin, decided on the physical
    inventory first: a skill the source selects and the cache lacks is stale, as are different
    skill folders, a different plugin.json (it decides the cache's selection) or different
    bytes. Unverifiable is only a layout not recognised, or a source that cannot say what it
    selects (spec §5.2, §10)."""
    cache = os.path.join(ctx.paths.codex_home, "plugins", "cache", m.name, name, str(version))
    if not version or not os.path.isdir(cache):
        return "unverifiable"
    try:
        pdir = cat.plugin_dir(name)
        selected = sorted(os.path.relpath(s.path, pdir) for s in cat.skills(name))
        theirs = {rel: digest_tree(os.path.join(pdir, rel))[0] for rel in selected}
    except (CatalogError, SymlinkError, OSError, TypeError):
        return "unverifiable"
    if any(not os.path.isfile(os.path.join(cache, rel, "SKILL.md")) for rel in selected) or \
            skill_dirs(cache) != skill_dirs(pdir) or \
            file_bytes(cache, DESCRIPTOR) != file_bytes(pdir, DESCRIPTOR):
        return "stale"
    for rel, digest in theirs.items():
        try:
            if digest_tree(os.path.join(cache, rel))[0] != digest:
                return "stale"
        except (SymlinkError, OSError):
            return "stale"          # what the cache holds is not what the source holds
    return "match"


DESCRIPTOR = os.path.join(".claude-plugin", "plugin.json")


def file_bytes(root, rel):
    try:
        with open(os.path.join(root, rel), "rb") as f:
            return f.read()
    except FileNotFoundError:
        return None


def codex_plugin(ctx, m, src, cat, e, observed):
    """Install, check or repair one plugin. A change is verified later, against the list taken
    after it (codex_verify)."""
    h = "codex"
    add = ["codex", "plugin", "add", "--json", e.id]
    at = "checkout %s" % src.label() if src.kind == "checkout" else src.label()
    if observed is None:
        if not ctx.apply:
            return planned(ctx, h, e.id, add)
        r = ctx.runner.run(add)
        if not r.ok or not isinstance(json_document(r.stdout), dict):
            return ctx.report.add(h, e.id, "failed", r.error())
        return ctx.report.add(h, e.id, "installed", "", at=at)
    version = observed.get("version")
    if observed.get("enabled") is False:
        return ctx.report.add(h, e.id, "failed", "%s, installed but disabled in Codex; enable it "
                                                 "there (agent-sync has no verb for it)" % version)
    if cat is None:
        return ctx.report.add(h, e.id, "unchecked", "%s; catalog not fetched, cache not "
                                                    "compared" % version)
    verdict = codex_cache_check(ctx, m, cat, e.name, version)
    if verdict == "match":
        return ctx.report.add(h, e.id, "unchanged", "%s, cache digest matches %s" % (version, at))
    if verdict == "unverifiable":
        return ctx.report.add(h, e.id, "unverifiable", "%s; cache layout not recognised, not "
                                                       "compared" % version)
    stale = "cache differs from %s at the same version; see \"Codex stale cache\" in " \
            "docs/agent-sync.md" % at
    if not getattr(ctx.args, "repair", False):
        return ctx.report.add(h, e.id, "stale", stale)
    if not ctx.apply:
        return planned(ctx, h, e.id, add, stale + "; ")
    r = ctx.runner.run(add)
    if not r.ok:
        return ctx.report.add(h, e.id, "failed", "repair failed, cache left as it was: "
                              + r.error())
    return ctx.report.add(h, e.id, "updated", "repaired", at=at, stale=stale)


def codex_verify(ctx, m, cat, row, p):
    """Settle an installed or repaired row from the list taken after the change."""
    at = row.extra.pop("at")
    stale = row.extra.pop("stale", None)
    if p is None:
        row.result, row.detail = "failed", "Codex reported success, but does not list it"
        return
    version = p.get("version")
    verdict = codex_cache_check(ctx, m, cat, row.item.partition("@")[0], version) \
        if cat else "unverifiable"
    if p.get("enabled") is False:
        row.result, row.detail = "failed", "%s, installed but disabled in Codex" % version
    elif verdict == "match":
        row.detail = "%s, %scache digest matches %s" % (version, "repaired: " if stale else "",
                                                       at)
    elif stale or verdict == "stale":
        row.result = "stale"
        row.detail = (stale or "cache differs from %s right after install" % at) + \
            ("; still differs after --repair" if stale else "")
    else:
        row.detail = "%s; cache layout not recognised, not compared" % version


def sync_codex(ctx):
    h = "codex"
    if h not in ctx.harnesses or not harness_present(ctx, h) or not harness_home(ctx, h):
        return
    r = ctx.runner.run(["codex", "plugin", "marketplace", "list", "--json"])
    doc = json_document(r.stdout) if r.ok else None
    if not isinstance(doc, dict) or not isinstance(doc.get("marketplaces"), list):
        ctx.report.add(h, "codex CLI", "failed", "cannot read its marketplaces: %s"
                       % (r.error() if not r.ok else "unexpected output"))
        return
    if not all(isinstance(mk, dict) and isinstance(mk.get("name"), str)
               for mk in doc["marketplaces"]):
        ctx.report.add(h, "codex CLI", "failed", "cannot read its marketplaces: an entry has no "
                                                 "string name")
        return
    markets = {mk["name"]: mk for mk in doc["marketplaces"]}
    refs = codex_refs(ctx)
    state = ctx.applied(h)
    work = []
    for m in marketplaces_for(ctx, h):      # marketplaces first, then their plugins (spec §10)
        try:
            src, cat = resolve_marketplace(ctx, m, h)
            if src is None:
                continue
            if cat is None and m.plugins == "all":
                ctx.report.add(h, "marketplace %s" % m.name, "unchecked", "catalog not fetched "
                               "yet; its plugins are listed by --check or a run")
                continue
            enrolled, failed = enrol(ctx, m, h, cat)
            proceed = codex_marketplace(ctx, m, src, markets.get(m.name), refs, state)
            ctx.save_state()
        except ITEM_ERRORS as e:
            ctx.report.add(h, "marketplace %s" % m.name, "failed", str(e))
            continue
        work.append((m, src, cat, enrolled, failed, proceed))
    for m, src, cat, enrolled, failed, proceed in work:
        for pid, why in failed:
            ctx.report.add(h, pid, "failed", why)
        if not proceed:
            skip_plugins(ctx, h, enrolled, "marketplace %s needs attention above" % m.name)
            continue
        present = markets.get(m.name) is not None or ctx.apply
        installed = codex_plugins(ctx, m.name) if present else {}
        if installed is None:
            skip_plugins(ctx, h, enrolled, "its plugins could not be listed")
            continue
        rows = []
        for e in enrolled:
            try:
                rows.append(codex_plugin(ctx, m, src, cat, e, installed.get(e.id)))
            except ITEM_ERRORS as err:
                ctx.report.add(h, e.id, "failed", str(err))
        changed = [row for row in rows if row is not None and "at" in row.extra]
        if changed:
            installed = codex_plugins(ctx, m.name) or {}
            for row in changed:
                codex_verify(ctx, m, cat, row, installed.get(row.item))
        record_selection(ctx, h, m, cat, enrolled, installed)
        ids = {e.id for e in enrolled}
        for pid in installed:
            if pid not in ids:
                ctx.report.add(h, pid, "unmanaged", "not in the manifest; left as it is")


# ── agy: skill copies (spec §5.3, §6) ─────────────────────────────────────────────────────────

def catalog_links(tree):
    """Every symlink in a catalog, relative: each one is a resolution error (spec §10)."""
    out = []
    for d, dirs, names in os.walk(tree):
        dirs[:] = [n for n in dirs if n != ".git"]
        out += [os.path.relpath(os.path.join(d, n), tree) for n in dirs + names
                if os.path.islink(os.path.join(d, n))]
    return sorted(out)


def agy_selection(ctx):
    """Every skill the manifest selects for agy, with failures reported -> ([(Skill, label)],
    errors). Any resolution error, here or in a skill listing, means the selection is not
    known completely, and prune waits for a run without one (spec §10)."""
    h, out, errors = "agy", [], []

    def failed(item, why, result="failed"):
        ctx.report.add(h, item, result, why)
        errors.append(item)

    for m in marketplaces_for(ctx, h):
        try:
            src, cat = resolve_marketplace(ctx, m, h)       # a failure has its row already
            if cat is None:
                errors.append("marketplace %s" % m.name)
                if src is not None:
                    ctx.report.add(h, "marketplace %s" % m.name, "unchecked", "catalog not "
                                   "fetched yet; its skills are listed by --check or a run")
                continue
            enrolled, bad = enrol(ctx, m, h, cat)
        except ITEM_ERRORS as err:
            failed("marketplace %s" % m.name, str(err))
            continue
        links = catalog_links(cat.tree)
        if links:
            failed("marketplace %s" % m.name, "holds symlinks, which agent-sync never reads: "
                   "%s; its other skills are copied" % ", ".join(links[:5]))
        for pid, why in bad:
            failed(pid, why)
        for e in enrolled:
            try:
                skills = cat.skills(e.name)
                unknown = sorted(set(e.agy_skills or ()) - {s.name for s in skills})
                if unknown:
                    raise CatalogError("agy_skills names %s, not a skill of this plugin"
                                       % ", ".join(unknown))
            except ITEM_ERRORS as err:
                failed(e.id, str(err))
                continue
            if e.agy_skills is not None:
                skills = [s for s in skills if s.name in e.agy_skills]
            out += [(s, src.label()) for s in skills]
    for s in ctx.manifest.skills:
        if s.path:
            out.append((Skill(s.name, s.path, None, front_matter_error(s.path)), None))
            continue
        src = git_source(ctx, "skill", git_url(s.git), s.ref)
        path = os.path.join(src.tree, s.subdir) if src.tree and s.subdir else src.tree
        why = src.error or (None if src.tree else "source not fetched yet")
        if not why:
            try:
                contained(src.tree, path)
            except CatalogError as err:
                why = str(err)
        if not why and not os.path.isfile(os.path.join(path, "SKILL.md")):
            why = "%s holds no SKILL.md" % (s.subdir or "the repository")
        if why:
            failed(s.name, why, "failed" if src.tree or src.error else "unchecked")
            continue
        out.append((Skill(s.name, path, None, front_matter_error(path)), src.label()))
    return out, errors


def agy_item(skill):
    return "%s/%s" % (skill.plugin.partition("@")[0], skill.name) if skill.plugin else skill.name


def agy_reserved(ctx, plugins, fold):
    """Names agy already has: its bundled skills and every installed agy plugin's skills."""
    reserved = {}
    if os.path.isdir(ctx.paths.agy_builtin):
        for n in os.listdir(ctx.paths.agy_builtin):
            reserved[fold(n)] = "a skill bundled with agy"
    for p in plugins:
        for n in p.get("skills") or []:
            reserved.setdefault(fold(str(n)), "agy plugin %s" % p.get("name"))
    return reserved


def case_insensitive(path):
    """Whether the volume holding path compares names without case: read-only, by looking up
    an existing ancestor under its other case."""
    p = path
    while not os.path.lexists(p) and p != os.path.dirname(p):
        p = os.path.dirname(p)
    while p != os.path.dirname(p):
        base = os.path.basename(p)
        if base.lower() != base.upper():
            other = os.path.join(os.path.dirname(p), base.swapcase())
            return os.path.lexists(other) and os.path.samefile(other, p)
        p = os.path.dirname(p)
    return False


def agy_copy(ctx, skill, label, owned):
    """Copy one skill. `owned` maps a folded name to the name the state file records."""
    h, item, name = "agy", agy_item(skill), skill.name
    dest = os.path.join(ctx.paths.agy_skills, name)
    key = owned.get(ctx.fold(name))
    record = ctx.state.data["agy"].get(key) if key else None
    try:
        digest, count = digest_tree(skill.path)
    except SymlinkError as e:
        return ctx.report.add(h, item, "failed", "%s; not copied (Rule #1: no symlinks in $HOME)"
                              % e)
    label = label or "local folder, digest %s" % digest[:7]
    if os.path.lexists(dest):
        try:
            current = digest_tree(dest)[0]
        except SymlinkError:
            current = None
        if record is None and name not in ctx.adopt:
            return ctx.report.add(h, item, "held", "%s exists and is not agent-sync's; --adopt %s"
                                  % (tilde(dest), name), reason="foreign")
        if current == digest and record is not None and key == name:
            # Already what a copy would write. The record follows the source that selects it
            # now, and catches up after a state write that failed (spec §6, §10).
            now = {"source": skill.plugin or "skill " + name, "path": skill.path,
                   "revision": label, "digest": digest}
            if any(record.get(k) != v for k, v in now.items()) and ctx.apply:
                with critical():
                    record.update(now, time=datetime.datetime.now().isoformat(timespec="seconds"))
                    ctx.save_state("agy record of %s" % tilde(dest))
            return ctx.report.add(h, item, "unchanged", label.split(" (")[0])
        if record is not None and current != record.get("digest") and name not in ctx.adopt:
            return ctx.report.add(h, item, "held", "%s was edited by hand since agent-sync "
                                                   "copied it; --adopt %s overwrites it (the "
                                                   "edited copy is archived)"
                                  % (tilde(dest), name), reason="edited")
    if not ctx.apply:
        return ctx.report.add(h, item, "unchecked", "would copy %s, %s to %s"
                              % (label, files(count), tilde(dest)))
    archive = os.path.join(ctx.paths.archive, ctx.ts, "agy", name)
    with critical():        # the swap and its record are one operation (spec §6)
        try:
            got = install_tree(skill.path, dest, ctx.paths.agy_stage, archive)
        except TreeError as e:
            return ctx.report.add(h, item, "failed", str(e))
        ctx.state.data["agy"].pop(key, None)
        ctx.state.data["agy"][name] = {
            "source": skill.plugin or "skill " + name, "path": skill.path, "revision": label,
            "digest": got["digest"], "time": datetime.datetime.now().isoformat(timespec="seconds")}
        owned[ctx.fold(name)] = name
        detail = "%s, %s" % (label, files(got["files"]))
        if got["archived"]:
            detail += "; previous copy archived to %s" % tilde(got["archived"])
        row = ctx.report.add(h, item, "copied", detail)   # inside: Ctrl-C keeps it
        ctx.save_state("the copy at %s%s%s" % (
            tilde(dest), "; the previous one is at " + tilde(got["archived"])
            if got["archived"] else "", "; a first copy is held next run until --adopt " + name
            if record is None else ""))
    return row


def sync_agy(ctx):
    h = "agy"
    if h not in ctx.harnesses or not harness_present(ctx, h):
        return
    # Before the first agy command, which initialises its home (C1, spec §8).
    for p in (os.path.join(ctx.paths.home, ".gemini"), ctx.paths.gemini_config,
              ctx.paths.agy_skills, ctx.paths.agy_stage):
        if os.path.islink(p):
            ctx.report.add(h, "skills folder", "failed", "%s is a symlink; agent-sync writes "
                                                         "nothing there" % tilde(p))
            return
    plugins = []
    if harness_home(ctx, h):
        r = ctx.runner.run(["agy", "plugin", "list", "--json"])
        plugins = json_document(r.stdout) if r.ok else None
        if not isinstance(plugins, list) or not all(
                isinstance(p, dict) and isinstance(p.get("name"), str) and
                isinstance(p.get("skills", []), list) and
                all(isinstance(n, str) for n in p.get("skills", [])) for p in plugins):
            ctx.report.add(h, "agy CLI", "failed", "cannot read its plugins: %s"
                           % (r.error() if not r.ok else "unexpected output"))
            return
    # Names compare the way the destination volume compares them (spec §6).
    ctx.fold = str.lower if case_insensitive(ctx.paths.agy_skills) else str
    selection, errors = agy_selection(ctx)
    reserved = agy_reserved(ctx, plugins, ctx.fold)
    owned = {ctx.fold(n): n for n in ctx.state.data["agy"]}
    by_name = {}
    for skill, label in selection:
        by_name.setdefault(ctx.fold(skill.name), []).append((skill, label))
    for key, entries in by_name.items():
        for skill, label in entries:
            others = [agy_item(s) for s, _ in entries if s is not skill]
            if key in reserved:
                others.append(reserved[key])
            try:
                if others:
                    ctx.report.add(h, agy_item(skill), "failed", "name collision with %s; nothing "
                                   "written for %s; give one plugin an agy_skills subset"
                                   % (", ".join(others), skill.name), reason="name collision")
                elif skill.error:
                    ctx.report.add(h, agy_item(skill), "failed", skill.error)
                else:
                    agy_copy(ctx, skill, label, owned)
            except ITEM_ERRORS as e:
                ctx.report.add(h, agy_item(skill), "failed", str(e))
    # An orphan is known only from a selection read without any error: an unreadable one says
    # nothing about what was removed, so neither orphans nor prune follow from it (spec §10).
    if errors:
        if ctx.args.prune:
            ctx.report.add(h, "prune", "skipped", "nothing archived: the selection was not read "
                           "completely (%s); run --prune again once it is" % ", ".join(errors))
        return
    for name in sorted(set(ctx.state.data["agy"])):
        if ctx.fold(name) in by_name:
            continue
        dest = os.path.join(ctx.paths.agy_skills, name)
        if not ctx.args.prune or not ctx.apply:
            ctx.report.add(h, name, "orphaned", "%s left the manifest; --prune archives it"
                           % tilde(dest))
            continue
        try:
            with critical():
                moved = archive_tree(dest, os.path.join(ctx.paths.archive, ctx.ts, "agy", name)) \
                    if os.path.lexists(dest) else None
                del ctx.state.data["agy"][name]
                ctx.report.add(h, name, "archived", "moved to %s" % tilde(moved) if moved else
                               "already gone; forgotten")
                ctx.save_state("the archive of %s%s" % (tilde(dest), " at " + tilde(moved)
                                                        if moved else ""))
        except ITEM_ERRORS as e:
            ctx.report.add(h, name, "failed", "cannot archive %s: %s" % (tilde(dest), e))


def report_available(ctx):
    """`available` rows: catalog plugins a "listed" marketplace does not enrol (spec §3)."""
    for m in ctx.manifest.marketplaces.values():
        if m.plugins != "listed":
            continue
        listed = {r.name for r in ctx.manifest.plugins.values() if r.marketplace == m.name}
        seen = []
        for h in ctx.manifest.harnesses_using(m):
            if h not in ctx.harnesses or m.source[h] == "none":
                continue
            src = ctx.sources.get(("checkout", m.checkout) if m.source[h] == "checkout"
                                  else cache_name("marketplace", git_url(m.git), m.ref))
            cat = ctx.catalogs.get(src.tree) if src and src.tree else None
            for name in (cat.entries if cat else ()):
                if name not in listed and name not in seen:
                    seen.append(name)
        for name in seen:
            ctx.report.add("-", "%s@%s" % (name, m.name), "available",
                           "in the catalog, not in the manifest")


# ── Duplicates (spec §7) ──────────────────────────────────────────────────────────────────────

def flat_root(ctx, harness):
    return ctx.paths.claude_flat if harness == "claude" else ctx.paths.codex_flat


def flat_names(root):
    """Skill folders directly in a flat root; `synced/` (account-synced, D4) is never one."""
    if not os.path.isdir(root):
        return []
    return sorted(n for n in os.listdir(root) if not n.startswith(".") and n != "synced"
                  and NAME.match(n) and os.path.isdir(os.path.join(root, n)))


def report_external(ctx):
    for h in ("claude", "codex"):
        if h in ctx.harnesses:
            root = flat_root(ctx, h)
            for n in flat_names(root):
                if n in ctx.manifest.external:
                    ctx.report.add(h, n, "external", tilde(os.path.join(root, n)))


def report_duplicates(ctx):
    for h in ("claude", "codex"):
        root, sel = flat_root(ctx, h), ctx.selected.get(h, {})
        for n in flat_names(root):
            if n in sel and n not in ctx.manifest.external:
                ctx.report.add(h, n, "duplicate", "plugin %s (%s) and %s; run `agent-sync "
                               "cleanup`" % (sel[n][0], tilde(sel[n][3] or sel[n][1]),
                                             tilde(os.path.join(root, n))))


SYNC_STEPS[:] = [sync_claude, sync_codex, report_external, report_available, report_duplicates,
                 sync_agy]


# ── Cleanup (spec §9) ─────────────────────────────────────────────────────────────────────────

HARNESS_NAMES = {"claude": "Claude Code", "codex": "Codex"}


def compare_trees(copy, plugin):
    """The content line for a candidate; a tree that cannot be read says so."""
    try:
        mine, theirs = tree_files(copy), tree_files(plugin)
    except OSError as e:
        return "cannot be read (%s), so it is never identical" % e
    changed = sorted(p for p in mine if p in theirs and mine[p] != theirs[p])
    only_copy = sorted(set(mine) - set(theirs))
    only_plugin = sorted(set(theirs) - set(mine))
    if not (changed or only_copy or only_plugin):
        return "identical to the plugin"
    parts = []
    if changed:
        parts.append(files(len(changed)) + " changed")
    if only_copy:
        parts.append("%d only in the copy (%s)" % (len(only_copy), ", ".join(only_copy)))
    if only_plugin:
        parts.append("%d only in the plugin (%s)" % (len(only_plugin), ", ".join(only_plugin)))
    return "DIFFERS from the plugin: " + ", ".join(parts)


def unified_diff(copy, plugin):
    mine, theirs = tree_files(copy), tree_files(plugin)
    out = []
    for rel in sorted(set(mine) | set(theirs)):
        a = theirs.get(rel, b"").decode(errors="replace").splitlines(True)
        b = mine.get(rel, b"").decode(errors="replace").splitlines(True)
        out += difflib.unified_diff(a, b, "plugin/" + rel, "copy/" + rel)
    return "".join(out)


def holds_link(path):
    """Whether path is a symlink or holds one at any depth, dot names included."""
    return os.path.islink(path) or any(
        os.path.islink(os.path.join(d, n)) for d, dirs, names in os.walk(path)
        for n in dirs + names)


def snapshot(path):
    """A copy's digest as it is now, or None when it cannot be read: what was shown."""
    try:
        return digest_tree(path)[0]
    except (SymlinkError, OSError):
        return None


def cleanup_candidates(ctx):
    """Observe Claude and Codex read-only, as a dry run does, and match their flat roots. A
    copy is compared with the tree the harness loads, never with a newer catalog (spec §9)."""
    saved = ctx.report, ctx.dry_run, ctx.apply, ctx.fetch
    ctx.report, ctx.dry_run, ctx.apply, ctx.fetch = Report(), True, False, False
    try:
        sync_claude(ctx)
        sync_codex(ctx)
    finally:
        problems = [r for r in ctx.report.rows if r.result == "failed"]
        ctx.report, ctx.dry_run, ctx.apply, ctx.fetch = saved
    out = []
    for h in ("claude", "codex"):
        root, sel = flat_root(ctx, h), ctx.selected.get(h, {})
        for n in flat_names(root):
            if n in sel and n not in ctx.manifest.external:
                pid, path, version, loaded = sel[n]
                c = {"harness": h, "name": n, "path": os.path.join(root, n), "plugin": pid,
                     "plugin_path": loaded or path, "version": version,
                     "link": holds_link(os.path.join(root, n)),
                     "digest": snapshot(os.path.join(root, n))}
                c["content"] = "it is or holds a symlink; not compared" if c["link"] else \
                    compare_trees(c["path"], c["plugin_path"])
                # Identical needs two digests actually computed: an unreadable tree, or one
                # holding a link, is equal to nothing (spec §10).
                c["identical"] = loaded is not None and not c["link"] and \
                    c["digest"] is not None and c["digest"] == snapshot(c["plugin_path"])
                if loaded is None:
                    c["content"] = "the installed tree was not found; against the catalog: " \
                        + c["content"]
                out.append(c)
    return out, problems


def provenance(ctx, name):
    """The skills CLI's lock entry for a name, read-only, or None (spec §9)."""
    try:
        with open(os.path.join(ctx.paths.home, ".agents", ".skill-lock.json")) as f:
            entry = json.load(f).get("skills", {}).get(name)
    except (OSError, ValueError, AttributeError):
        return None
    if isinstance(entry, dict):
        return "skills CLI lock entry, %s source; the entry is left in place" \
            % entry.get("sourceType", "unknown")
    return None


def run_cleanup(ctx):
    args = ctx.args
    if args.restore:
        return cleanup_restore(ctx, args.restore)
    cands, problems = cleanup_candidates(ctx)
    for row in problems:
        print("warning: %s %s: %s" % (row.harness, row.item, row.detail))
    unknown = [n for n in args.yes if n not in {c["name"] for c in cands}]
    if unknown:
        raise UsageError("not a cleanup candidate: %s" % ", ".join(unknown))
    code = cleanup_session(ctx, cands)
    return EXIT_FAILED if problems else code


def cleanup_session(ctx, cands):
    args, ts = ctx.args, ctx.ts
    print("agent-sync %s cleanup · manifest %s\n" % (VERSION, tilde(ctx.manifest.path)))
    if not cands:
        print("No flat copy shadows a managed, enabled plugin.")
    auto = stopped = False
    archived, code = [], EXIT_OK
    for i, c in enumerate(cands, 1):
        dest = os.path.join(ctx.paths.archive, ts, c["harness"], c["name"])
        print("[%d/%d] %s" % (i, len(cands), tilde(c["path"])))
        print("  shadows    skill %s of plugin %s, installed in %s %s"
              % (c["name"], c["plugin"], HARNESS_NAMES[c["harness"]], c["version"]))
        print("  content    " + c["content"])
        if provenance(ctx, c["name"]):
            print("  provenance " + provenance(ctx, c["name"]))
        if c["link"]:
            print("  action     none: it is or holds a symlink, so it is listed and never "
                  "archived (moving a link changes what it points at)\n")
            continue
        print("  action     move to %s" % tilde(dest))
        if args.dry_run or stopped:
            print()
            continue
        if args.yes:
            answer = "y" if c["name"] in args.yes else "n"
        elif auto and c["identical"]:
            answer = "y"
        else:
            answer = None
        while answer is None:
            sys.stdout.write("Archive this copy? [y]es / [n]o / [d]iff / [a]ll remaining "
                             "identical / [q]uit ")
            sys.stdout.flush()
            line = sys.stdin.readline()
            if not line:
                print("\nno answer; stopping (non-interactive use needs --yes <name>…)")
                answer = "q"
                break
            answer = {"y": "y", "n": "n", "d": "d", "a": "a", "q": "q"}.get(line.strip()[:1])
            if answer == "d":
                try:
                    print(unified_diff(c["path"], c["plugin_path"]) or "(no differences)")
                except OSError as e:
                    print("cannot be read: %s" % e)
                answer = None
            elif answer == "a":
                auto = True
                answer = "y" if c["identical"] else "n"     # a differing copy is kept
            if answer == "y" and not args.yes:
                answer = recheck(ctx, c)
        if answer == "q":
            stopped = True
        elif answer == "y":
            try:
                def unchanged(c=c):
                    now = snapshot(c["path"])
                    if now is None or now != c["digest"]:
                        raise TreeError("it changed since it was shown, or cannot be read; "
                                        "run cleanup again to see it")

                with critical():    # the move and its record are one operation
                    moved = archive_tree(c["path"], dest, "src", unchanged)
                    ctx.state.data["cleanup"].setdefault(ts, []).append(
                        {"harness": c["harness"], "name": c["name"],
                         "slot": os.path.basename(moved)})
                    if not ctx.save_state("the archive of %s at %s"
                                          % (tilde(c["path"]), tilde(moved))):
                        print("  moved to %s, but the state file could not be written, so "
                              "--restore will not find it; move it back by hand to undo"
                              % tilde(moved))
                        code = EXIT_FAILED
                        continue
                archived.append(c["name"])
                print("  archived")
            except ITEM_ERRORS as e:
                print("  not archived: %s" % e)
                code = EXIT_FAILED
        print()
    print("Not touched:")
    synced = os.path.join(ctx.paths.codex_flat, "synced")
    if os.path.isdir(synced):
        print("  %s/: %d folders, not touched (account-synced; see D4)"
              % (tilde(synced), len([n for n in os.listdir(synced) if not n.startswith(".")])))
    for h in ("claude", "codex"):
        for n in flat_names(flat_root(ctx, h)):
            if n in ctx.manifest.external:
                print("  %s: listed under [external]" % tilde(os.path.join(flat_root(ctx, h), n)))
    if archived:
        print("\nArchived %d: %s. The skills CLI's lock entries are left in place, so "
              "`skills list` will show archived copies as missing." % (len(archived),
                                                                       ", ".join(archived)))
        print("Undo: agent-sync cleanup --restore %s" % ts)
    return code


def recheck(ctx, c):
    """At the answer, the copy is read again; one that changed while the question was open is
    shown again and asked about again, never archived unseen (spec §10). -> "y", "n" or None."""
    now = snapshot(c["path"])
    if now is not None and now == c["digest"]:
        return "y"
    if now is None or holds_link(c["path"]):
        print("  it cannot be read now, or holds a symlink; not archived")
        return "n"
    c["digest"], c["identical"] = now, False
    c["content"] = compare_trees(c["path"], c["plugin_path"])
    print("  changed since it was shown; it now reads:\n  content    " + c["content"])
    return None


def cleanup_restore(ctx, ts):
    """Move one cleanup run's folders back. Paths are rebuilt from validated names, never read
    from the state file; with --dry-run nothing moves (spec §9, §10)."""
    records = ctx.state.data["cleanup"].get(ts)
    if not records:
        raise UsageError("no cleanup run %s in %s" % (ts, tilde(ctx.paths.state)))
    failed = False
    for rec in list(records):
        back = os.path.join(flat_root(ctx, rec["harness"]), rec["name"])
        held = os.path.join(ctx.paths.archive, ts, rec["harness"], rec["slot"])
        if os.path.lexists(back):
            print("%s exists again; not restored (the archived copy stays at %s)"
                  % (tilde(back), tilde(held)))
        elif os.path.islink(held) or not os.path.isdir(held):
            print("%s is missing from the archive, or not a folder; not restored" % tilde(held))
        elif ctx.args.dry_run:
            print("would restore %s from %s" % (tilde(back), tilde(held)))
            continue
        else:
            try:
                with critical():    # the move and its record are one operation
                    move_exact(held, back, "dst")   # exactly this name, or not at all (§10)
                    records.remove(rec)
                    if not records:
                        del ctx.state.data["cleanup"][ts]
                    if ctx.save_state("the restore of %s" % tilde(back)):
                        print("restored %s" % tilde(back))
                        continue
                print("restored %s, but the state file could not be written, so it still "
                      "lists %s as archived" % (tilde(back), ts))
            except ITEM_ERRORS as e:
                print("%s not restored: %s" % (tilde(back), e))
        failed = True
    return EXIT_FAILED if failed else EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
